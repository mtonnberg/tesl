; Stdlib constructor field-LABEL seam test (GitHub #69's drift class closer):
; Emit_racket.stdlib_ctor_fields tells pattern_to_racket which hash key each
; POSITIONAL sub-pattern binds, and a missing row silently lowers
; `case t of Tuple3 a b c` to (hash-ref … 'a) — green through the whole gate,
; dead at runtime.  This pins the table against the RUNTIME in both directions
; (rows match real ordered labels; no field-carrying ctor lacks a row), with the
; labels recovered by applying each constructor to sentinels.  Self-skips loudly
; without racket:
;   dune exec test/test_stdlib_ctor_labels.exe
(tests
 (names test_stdlib_ctor_labels)
 (modules test_stdlib_ctor_labels)
 (libraries tesl_compiler_lib alcotest str unix))

; Go stdlib EXPORT seam test: every (module, export) in the checker's own allowlist is
; compiled through the Go emitter, and the set the fallthrough catches is pinned against an
; explicit list.  Without this, adding a stdlib export routes it straight to the
; `| other -> unsupported …` arm — refused at the USER's compile time with no signal at ours,
; so the fallthrough would quietly eat every future addition:
;   dune exec test/test_go_stdlib_export_seam.exe
(tests
 (names test_go_stdlib_export_seam)
 (modules test_go_stdlib_export_seam)
 (libraries tesl_compiler_lib alcotest str unix))

