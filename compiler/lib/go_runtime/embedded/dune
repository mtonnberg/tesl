; The real runtime snapshot.  (mode promote) writes the generated file back into the
; source tree so `git diff` shows drift; ci.sh's embedded-sync phase fails on an
; uncommitted diff here, and test_embedded_go_runtime_seam.ml compares it byte for
; byte with runtime/go/teslrt.  Every runtime file MUST appear in (deps …) below AND
; in gen/gen_go_runtime.ml, or an edit to it never reaches the embedded copy.
(library
 (name tesl_go_runtime_embedded)
 (implements tesl_go_runtime))

; Keep generated Go projects standalone: runtime source is embedded in the
; compiler, not read from TESL_REPO_ROOT at emission time.
(rule
 (target embedded_go_runtime.ml)
 (mode promote)
  (deps ../../../../runtime/go/teslrt/agent.go ../../../../runtime/go/teslrt/agent_endpoint.go ../../../../runtime/go/teslrt/agent_provider.go ../../../../runtime/go/teslrt/apitest.go ../../../../runtime/go/teslrt/apitest_json.go ../../../../runtime/go/teslrt/cache.go ../../../../runtime/go/teslrt/check.go ../../../../runtime/go/teslrt/control.go ../../../../runtime/go/teslrt/crypto.go ../../../../runtime/go/teslrt/debug.go ../../../../runtime/go/teslrt/debug_control.go ../../../../runtime/go/teslrt/debug_file_unix.go ../../../../runtime/go/teslrt/debug_file_windows.go ../../../../runtime/go/teslrt/debug_sql.go ../../../../runtime/go/teslrt/debug_state.go ../../../../runtime/go/teslrt/debug_value.go ../../../../runtime/go/teslrt/dict.go ../../../../runtime/go/teslrt/env.go ../../../../runtime/go/teslrt/either.go ../../../../runtime/go/teslrt/email.go ../../../../runtime/go/teslrt/float.go ../../../../runtime/go/teslrt/hostclass.go ../../../../runtime/go/teslrt/hostname.go ../../../../runtime/go/teslrt/httpclient.go ../../../../runtime/go/teslrt/httpstub.go ../../../../runtime/go/teslrt/int.go ../../../../runtime/go/teslrt/int32.go ../../../../runtime/go/teslrt/json.go ../../../../runtime/go/teslrt/jws.go ../../../../runtime/go/teslrt/jwt.go ../../../../runtime/go/teslrt/list.go ../../../../runtime/go/teslrt/loadtest.go ../../../../runtime/go/teslrt/maybe.go ../../../../runtime/go/teslrt/migration_boundary.go ../../../../runtime/go/teslrt/migration_boundary_testbuild.go ../../../../runtime/go/teslrt/money.go ../../../../runtime/go/teslrt/currency_data.go ../../../../runtime/go/teslrt/database.go ../../../../runtime/go/teslrt/dbquery.go ../../../../runtime/go/teslrt/postgres.go ../../../../runtime/go/teslrt/units.go ../../../../runtime/go/teslrt/units_data.go ../../../../runtime/go/teslrt/password.go ../../../../runtime/go/teslrt/pgpubsub.go ../../../../runtime/go/teslrt/pgstores.go ../../../../runtime/go/teslrt/prop.go ../../../../runtime/go/teslrt/queue.go ../../../