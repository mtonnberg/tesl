(library
 (name tesl_migration_build)
 (wrapped false)
 (modules migration_build_snapshot))

; Keep the generated target outside the input glob: it cannot hash itself. These
; are Dune's staged compiler sources, including the generated lexer. Declared
; dependencies ensure the bytes exist before the fingerprint generator runs.
(rule
 (target migration_build_snapshot.ml)
 (deps (glob_files ../*.ml) (glob_files ../*.mli) ../lexer.mll ../dune ../../dune-project ../../bin/main.ml ../../gen/gen_migration_abi.ml)
 (action
  (with-stdout-to %{target}
   (run %{exe:../../gen/gen_migration_abi.exe} %{deps}))))
