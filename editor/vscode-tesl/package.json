{
  "name": "vscode-tesl",
  "displayName": "Tesl Language",
  "description": "Syntax highlighting, live diagnostics, go-to-definition, hover types, and completions for the Tesl (.tesl) language",
  "version": "0.7.2",
  "publisher": "Tesl",
  "namespace": "Tesl",
  "//extensionKind": "Run only on the workspace (remote/WSL) side. Without this, in a Remote-WSL session VSCode can run the extension on BOTH the local UI host and the remote workspace, starting two language-server clients that each publish diagnostics — so every error/warning appears twice.",
  "extensionKind": ["workspace"],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtonnberg/tesl"
  },
  "bugs": {
    "url": "https://github.com/mtonnberg/tesl/issues"
  },
  "homepage": "https://github.com/mtonnberg/tesl",
  "icon": "images/icon.png",
  "keywords": [
    "tesl",
    "language",
    "lsp",
    "web api",
    "gdp",
    "type safety"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:tesl",
    "workspaceContains:**/*.tesl"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tesl",
        "aliases": [
          "Tesl",
          "tesl"
        ],
        "extensions": [
          ".tesl"
        ],
        "configuration": "./language-configuration/tesl-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tesl",
        "scopeName": "source.tesl",
        "path": "./syntaxes/tesl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Tesl",
      "properties": {
        "tesl.lspScript": {
          "type": "string",
          "default": "",
          "description": "Absolute path to tesl-lsp.rkt (advanced override). Leave empty to use the tesl-lsp binary from PATH (installed via nix profile install github:mtonnberg/tesl) or to auto-detect from the workspace."
        },
        "tesl.dapBinary": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Go tesl-dap binary. Leave empty to use tesl-dap from PATH or go run the workspace runtime during development."
        }
      }
    },
    "debuggers": [
      {
        "type": "tesl",
        "label": "Tesl Debugger",
        "program": "./debug/launch-dap.sh",
        "runtime": "bash",
        "languages": [
          "tesl"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .tesl file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause at the first instrumented line on launch.",
                "default": false
              },
              "mode": {
                "type": "string",
                "enum": [
                  "program",
                  "test"
                ],
                "description": "What to run: 'program' executes the main function, 'test' runs test blocks.",
                "default": "program"
              },
              "testName": {
                "type": "string",
                "description": "When mode is 'test', run only the test block with this exact name (optional)."
              }
            }
          },
          "attach": {
            "properties": {
              "project": {
                "type": "string",
                "description": "Project root of the running `tesl run --debug` app (its .tesl-stuff/ holds the attach endpoint). Defaults to the workspace folder.",
                "default": "${workspaceFolder}"
              },
              "socket": {
                "type": "string",
                "description": "Explicit unix socket path of the attach endpoint (overrides project discovery)."
              },
              "port": {
                "type": "number",
                "description": "Explicit loopback TCP port of the attach endpoint (overrides project discovery)."
              },
              "program": {
                "type": "string",
                "description": "Legacy alias: with only `program` set, attach behaves like launch for that file."
              },
              "mode": {
                "type": "string",
                "enum": [
                  "program",
                  "test"
                ],
                "description": "Legacy alias mode (only used with `program`)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tesl",
            "request": "launch",
            "name": "Debug Tesl program",
            "program": "${file}",
            "mode": "program"
          },
          {
            "type": "tesl",
            "request": "launch",
            "name": "Debug Tesl tests",
            "program": "${file}",
            "mode": "test"
          },
          {
            "type": "tesl",
            "request": "attach",
            "name": "Attach to running app (tesl run --debug)",
            "project": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Tesl: Debug program",
            "description": "Debug the current file's main function.",
            "body": {
              "type": "tesl",
              "request": "launch",
              "name": "Debug Tesl program",
              "program": "^\"\\${file}\"",
              "mode": "program"
            }
          },
          {
            "label": "Tesl: Debug tests",
            "description": "Debug the current file's test blocks.",
            "body": {
              "type": "tesl",
              "request": "launch",
              "name": "Debug Tesl tests",
              "program": "^\"\\${file}\"",
              "mode": "test"
            }
          },
          {
            "label": "Tesl: Attach to running app",
            "description": "Attach to an app started with `tesl run --debug` — the app keeps running when you disconnect.",
            "body": {
              "type": "tesl",
              "request": "attach",
              "name": "Attach to running app (tesl run --debug)",
              "project": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "tesl"
      }
    ],
    "commands": [
      {
        "command": "tesl.runDebugMode",
        "title": "Run current file in debug mode (tesl run --debug)",
        "category": "Tesl"
      },
      {
        "command": "tesl.attachRunning",
        "title": "Attach to running app",
        "category": "Tesl"
      },
      {
        "command": "tesl.debugTests",
        "title": "Debug Tesl Tests",
        "category": "Tesl"
      },
      {
        "command": "tesl.debugProgram",
        "title": "Debug Tesl Program",
        "category": "Tesl"
      },
      {
        "command": "tesl.runTests",
        "title": "Run Tesl Tests in Terminal",
        "category": "Tesl"
      },
      {
        "command": "tesl.runSingleTest",
        "title": "Run This Test",
        "category": "Tesl"
      },
      {
        "command": "tesl.debugSingleTest",
        "title": "Debug This Test",
        "category": "Tesl"
      },
      {
        "command": "tesl.runFunctionWithInput",
        "title": "Run Function with Input...",
        "category": "Tesl"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tesl.debugTests",
          "when": "resourceExtname == .tesl",
          "group": "tesl@1"
        },
        {
          "command": "tesl.debugProgram",
          "when": "resourceExtname == .tesl",
          "group": "tesl@2"
        },
        {
          "command": "tesl.runTests",
          "when": "resourceExtname == .tesl",
          "group": "tesl@3"
        },
        {
          "command": "tesl.runFunctionWithInput",
          "when": "resourceExtname == .tesl",
          "group": "tesl@4"
        }
      ],
      "explorer/context": [
        {
          "command": "tesl.debugTests",
          "when": "resourceExtname == .tesl",
          "group": "tesl@1"
        },
        {
          "command": "tesl.debugProgram",
          "when": "resourceExtname == .tesl",
          "group": "tesl@2"
        },
        {
          "command": "tesl.runTests",
          "when": "resourceExtname == .tesl",
          "group": "tesl@3"
        }
      ]
    }
  },
  "scripts": {
    "package": "npx @vscode/vsce package",
    "publish:vsce": "npx @vscode/vsce publish",
    "publish:ovsx": "npx ovsx publish"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0"
  }
}
