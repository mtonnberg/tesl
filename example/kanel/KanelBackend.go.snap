//line KanelBackend.tesl:827
func Main() struct{} {
//line KanelBackend.tesl:827
	return func() struct{} {
		var teslBound struct{}
		teslrt.WithDatabase(KanelDatabaseDatabase, func() {
			teslBound = (func() struct{} {
				port := teslrt.EnvInt("KANEL_PORT", teslrt.FromInt64(8080))
				_ = port
				_ = teslrt.StartWorkers(KanelNotifyQueueQueue, func(teslPayload any) teslrt.JobOutcome {
					switch teslJob := teslPayload.(type) {
					case KanelNotifyJob:
						_ = notifyWorker(teslJob)
					default:
						panic("KanelNotifyQueue: unexpected job payload")
					}
					return teslrt.JobOutcome{OK: true}
				}, 2, false)
				_ = teslrt.StartWorkers(KanelNotifyQueueQueue, func(teslPayload any) teslrt.JobOutcome {
					switch teslJob := teslPayload.(type) {
					case KanelNotifyJob:
						_ = deadNotifyWorker(teslJob)
					default:
						panic("KanelNotifyQueue: unexpected job payload")
					}
					return teslrt.JobOutcome{OK: true}
				}, 2, true)
				return teslrt.Serve(KanelServer, teslrt.ServeOptions{Port: teslrt.PortOf(port), StaticDir: "example/kanel/frontend"})
			}())
		})
		return teslBound
	}()
}

