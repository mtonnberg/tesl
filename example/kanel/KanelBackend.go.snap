					switch teslScrut4.Tag {
					case teslmodkanelmodels.InvoiceStatusDraft:
//line KanelBilling.tesl:53
						return teslrt.Accept(invoiceId)
					case teslmodkanelmodels.InvoiceStatusApproved:
//line KanelBilling.tesl:54
						return teslrt.Reject[string](422, "invoice is already approved and cannot be modified")
					case teslmodkanelmodels.InvoiceStatusSent:
//line KanelBilling.tesl:55
