// teslResetTestState empties the stores every test block starts from, so no block
// inherits another's rows, jobs, or outbound-HTTP stubs.
func teslResetTestState() {
	teslrt.ResetChannel(UserNotificationsChannel)
	teslrt.ResetQueue(KanelNotifyQueueQueue)
	teslrt.TableTruncate(teslmodkanelmodels.InvoiceTable)
	teslrt.TableTruncate(teslmodkanelmodels.IssueCommentTable)
	teslrt.TableTruncate(teslmodkanelmodels.IssueTable)
	teslrt.TableTruncate(teslmodkanelmodels.KanelUserTable)
	teslrt.TableTruncate(teslmodkanelmodels.OrgMembershipTable)
	teslrt.TableTruncate(teslmodkanelmodels.OrgTable)
	teslrt.TableTruncate(teslmodkanelmodels.ProjectMembershipTable)
	teslrt.TableTruncate(teslmodkanelmodels.ProjectTable)
	teslrt.TableTruncate(teslmodkanelmodels.TimeEntryTable)
}

