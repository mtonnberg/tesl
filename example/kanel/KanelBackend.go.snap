					case teslmodkanelmodels.InvoiceStatusPaid:
//line KanelBilling.tesl:56
						return teslrt.Reject[string](422, "invoice has been paid")
					case teslmodkanelmodels.InvoiceStatusOverdue:
//line KanelBilling.tesl:57
