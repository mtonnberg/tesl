//line KanelBackend.tesl:163
type KanelNotifyJob struct {
	RecipientUserId string
	RecipientEmail  string
	Subject         string
	Body            string
}

//line KanelBackend.tesl:183
type UserNotificationEventTag int

const (
	UserNotificationEventNotificationDelivered UserNotificationEventTag = iota
	UserNotificationEventNotificationFailed
)

type UserNotificationEvent struct {
	Tag                                 UserNotificationEventTag
	NotificationDeliveredRecipientEmail string
	NotificationDeliveredSubject        string
	NotificationFailedRecipientEmail    string
	NotificationFailedSubject           string
}

func (teslLeft UserNotificationEvent) TeslEqual(teslRight UserNotificationEvent) bool {
	if teslLeft.Tag != teslRight.Tag {
		return false
	}
	switch teslLeft.Tag {
	case UserNotificationEventNotificationDelivered:
		return teslEqualUserNotificationEventNotificationDelivered(teslLeft, teslRight)
	case UserNotificationEventNotificationFailed:
		return teslEqualUserNotificationEventNotificationFailed(teslLeft, teslRight)
	default:
		return true
	}
}

func teslEqualUserNotificationEventNotificationDelivered(teslLeft, teslRight UserNotificationEvent) bool {
	if !teslEqualString(teslLeft.NotificationDeliveredRecipientEmail, teslRight.NotificationDeliveredRecipientEmail) {
		return false
	}
	if teslLeft.NotificationDeliveredSubject != teslRight.NotificationDeliveredSubject {
		return false
	}
	return true
}

func teslEqualUserNotificationEventNotificationFailed(teslLeft, teslRight UserNotificationEvent) bool {
	if teslLeft.NotificationFailedRecipientEmail != teslRight.NotificationFailedRecipientEmail {
		return false
	}
	if teslLeft.NotificationFailedSubject != teslRight.NotificationFailedSubject {
		return false
	}
	return true
}

