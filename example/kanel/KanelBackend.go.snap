func CheckInvoiceDraft(invoiceId string) teslrt.Check[string] {
	{
//line KanelBilling.tesl:48
		found := teslrt.TableSelectOne(teslmodkanelmodels.InvoiceTable, func(inv teslmodkanelmodels.Invoice) bool {
