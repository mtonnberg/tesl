func notifyWorker(job KanelNotifyJob) KanelNotifyJob {
//line KanelBackend.tesl:194
	if job.RecipientEmail == "blocked@example.com" {
//line KanelBackend.tesl:195
		panic(teslrt.RequestRejection{Status: 500, Message: "notifications blocked for recipient"})
	} else {
		{
//line KanelBackend.tesl:197
			_ = teslrt.Publish(UserNotificationsChannel, job.RecipientUserId, teslEncode2(UserNotificationEvent{Tag: UserNotificationEventNotificationDelivered, NotificationDeliveredRecipientEmail: job.RecipientEmail, NotificationDeliveredSubject: job.Subject}))
//line KanelBackend.tesl:198
			return job
		}
	}
}

