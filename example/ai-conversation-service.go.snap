	teslValue.Id = teslColumn0
	teslValue.OwnerId = teslColumn1
	teslValue.Transcript = teslColumn2
	return teslValue, nil
}

func teslScanOrder(teslRow pgx.CollectableRow) (Order, error) {
	teslValue := Order{}
	var teslColumn0 string
	var teslColumn1 string
	if teslErr := teslRow.Scan(&teslColumn0, &teslColumn1); teslErr != nil {
		return teslValue, teslErr
	}
	teslValue.Id = teslColumn0
	teslValue.Status = teslColumn1
	return teslValue, nil
}

func teslToolArgs2(teslArgs string) []any {
	teslFields := teslrt.ToolArguments(teslArgs)
	return []any{teslrt.ToolArgString(teslFields, "orderId")}
}

func teslToolCall3(teslArgs []any) string {
	return LookupOrderStatus(teslArgs[0].(string))
}

// Declared in Tesl but not called within this module.  Tesl permits an unused
// private declaration; Go's linters do not, so these references keep them.
var (
	_ = Main
	_ = agentFor
	_ = claudeAgentFor
	_ = consumerAuth
	_ = keyOf
	_ = parseConversationId
	_ = providerOf
	_ = sendMessage
)

