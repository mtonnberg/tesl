module Schema.Notes.Migrate.V3 exposing [migration, fixture]
import Tesl.Migration exposing [Migration, Entity(..), Rule(..), Migrated(..)]
import Schema.Notes.V2
import Schema.Notes.VCurrent

migration = Migration {
from: Schema.Notes.V2
to: Schema.Notes.VCurrent
same: []
entities: { Note: Migrate convert [Retype metadata, WriteBack metadata metadata backward] }
fixtures: [fixture]
}
fn convert(old: Schema.Notes.V2.Note) -> Migrated Schema.Notes.VCurrent.Note =
if old.metadata.text == "blocked" then
  Reject "blocked V2 metadata"
else
  Row (Schema.Notes.VCurrent.Note {
  id: old.id
  metadata: Schema.Notes.VCurrent.Metadata { body: old.metadata.text, origin: old.metadata.detail, revision: 3 }
  })
fn backward(row: Schema.Notes.VCurrent.Note) -> Schema.Notes.V2.Metadata =
Schema.Notes.V2.Metadata { text: row.metadata.body, detail: row.metadata.origin }
fn fixture() -> Schema.Notes.V2.Note = Schema.Notes.V2.makeNote "fixture" "kept"
