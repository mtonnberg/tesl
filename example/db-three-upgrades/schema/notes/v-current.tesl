module Schema.Notes.VCurrent exposing [Note, Metadata, makeNote, makeMetadata, tryTitle]
import Tesl.Prelude exposing [String]
import Tesl.Maybe exposing [Maybe(..)]
import Tesl.Json exposing [stringCodec]

record Metadata { text: String }
codec Metadata {
  toJson { text -> "oldText" with_codec stringCodec }
  fromJson [ { text <- "oldText" with_codec stringCodec } ]
}
entity Note table "notes" primaryKey id { id: String, metadata: Metadata, author: String, memo: String, title: String }
fn makeMetadata(text: String) -> Metadata = Metadata { text: text }
fn tryTitle(text: String) -> Maybe String = Something text
fn makeNote(id: String, text: String) -> Maybe Note =
  Something (Note { id: id, metadata: makeMetadata text, author: "original-owner", memo: "retained-memo", title: text })
