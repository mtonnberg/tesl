module AdminTaskApi exposing [AdminTaskServer]
import Tesl.Prelude exposing [Bool(..), Int, String, Unit]
import Tesl.Json exposing [intCodec, stringCodec]
import Tesl.Http exposing [HttpRequest, Http.sessionToken]
import Tesl.Maybe exposing [Maybe(..)]
import Tesl.Dict exposing [Dict.lookup]
import Tesl.Telemetry exposing [telemetry, initTelemetry]
import Tesl.App exposing [App]
import Tesl.Database exposing [Database, DatabaseBackend, Memory]
import Tesl.Env exposing [requireSecret, envRead]
import Tesl.JWT exposing [jwt, JWT.verify]

# `envRead` belongs in the closure, not as an extra every caller must remember:
# the auth path reads the session signing key from the environment, so a
# capability that grants "read the auth cookie" has to grant that too.
capability readTaskCookie implies jwt, envRead

record AdminUser {
  id: String
  role: String
}

record AdminTask {
  id: Int
  title: String
  ownerId: String
}

codec AdminTask {
  toJson {
    id -> "id" with_codec intCodec
    title -> "title" with_codec stringCodec
    ownerId -> "ownerId" with_codec stringCodec
  }
  fromJson_forbidden
}

database AdminTaskDatabase = Database {
  entities: []
  backend: Memory
}

defaultExamplePort = 8088

fact Positive (taskId: Int)

check isPositive(taskId: Int) -> taskId: Int ::: Positive taskId =
  if taskId > 0 then
    ok taskId ::: Positive taskId
  else
    fail 400 "Task id must be positive"

fact Authenticated (req: AdminUser)

# THIS USED TO BE A PRIVILEGE-ESCALATION HOLE. It read `user` AND `role`
# straight out of the cookies, so any client could send `Cookie: user=x;
# role=admin` and reach the admin branch of `getAdminTask`. A value the client
# sends is a request to be an administrator, never evidence of being one.
#
# The session is now a signed token: `JWT.verify` checks the HMAC-SHA256
# signature and the `exp` claim and auto-401s on failure, and BOTH the subject
# and the role are claims INSIDE the signature — editing either one invalidates
# the token. The only place a role can be granted is where the token is minted,
# server-side, at login.
auth cookieUserAuth(request: HttpRequest) -> requestUser: AdminUser ::: Authenticated requestUser
  requires [readTaskCookie] =
  # `Http.sessionToken` reads the one fixed session cookie name, which lives in
  # the runtime rather than being re-spelled at every call site where a typo
  # would be a permanent 401 no test can tell from a real rejection.
  case Http.sessionToken request of
    Nothing -> fail 401 "Missing session cookie"
    Something token ->
      let claims = check JWT.verify token (requireSecret "SESSION_JWT_SECRET")
      case Dict.lookup "sub" claims of
        Nothing -> fail 401 "Session token has no subject"
        Something userId ->
          case Dict.lookup "role" claims of
            Something role -> ok AdminUser { id: userId, role: role } ::: Authenticated requestUser
            Nothing -> ok AdminUser { id: userId, role: "user" } ::: Authenticated requestUser

capturer positiveTaskCapture: Int ::: Positive taskId using intCodec via isPositive

handler getAdminTask(requestUser: AdminUser ::: Authenticated requestUser, taskId: Int ::: Positive taskId) -> AdminTask =
  if requestUser.role == "admin" then
    telemetry "task.fetch.admin" { user.id = requestUser.id, task.id = taskId }
    if taskId == 2 then
      { id: taskId, title: "Review audit log", ownerId: "anna" }
    else
      fail 404 "Task not found"
  else
    fail 403 "Admin role required"

api AdminTaskApi {
  get "/tasks/admin/:taskId"
    auth requestUser: AdminUser ::: Authenticated requestUser via cookieUserAuth
    capture taskId: Int ::: Positive taskId via positiveTaskCapture
    -> AdminTask
}

server AdminTaskServer for AdminTaskApi {
  getAdminTask = getAdminTask
}

main() -> App requires [readTaskCookie] =
  let _ = initTelemetry service "admin-task-api" endpoint "in-memory" console True
  App {
    database: AdminTaskDatabase
    api: AdminTaskServer
    port: defaultExamplePort
  }
