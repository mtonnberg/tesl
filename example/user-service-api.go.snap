// DecodeUserJSON is the DERIVED decoder for a record with no `codec` block: the type is the
// whole contract, exactly as it is on the Legacy runtime's generic decode.
func DecodeUserJSON(teslJSON any) teslrt.Check[User] {
	teslFields, teslShapeErr := teslrt.DecodeObjectShape(teslJSON, "User", []string{"id", "username", "emailAddress", "passwordHash", "bio", "avatarUrl", "createdAt"})
	if teslShapeErr != nil {
		return teslrt.RejectShape[User](teslShapeErr.Error())
	}
	teslFieldId, teslErrId := teslrt.DecodeStringValue(teslFields["id"])
	if teslErrId != nil {
		return teslrt.RejectShape[User](teslErrId.Error())
	}
	teslFieldUsername, teslErrUsername := teslrt.DecodeStringValue(teslFields["username"])
	if teslErrUsername != nil {
		return teslrt.RejectShape[User](teslErrUsername.Error())
	}
	teslFieldEmailAddress, teslErrEmailAddress := teslrt.DecodeStringValue(teslFields["emailAddress"])
	if teslErrEmailAddress != nil {
		return teslrt.RejectShape[User](teslErrEmailAddress.Error())
	}
	teslFieldPasswordHash, teslErrPasswordHash := teslrt.DecodeStringValue(teslFields["passwordHash"])
	if teslErrPasswordHash != nil {
		return teslrt.RejectShape[User](teslErrPasswordHash.Error())
	}
	teslFieldBio, teslErrBio := teslrt.DecodeStringValue(teslFields["bio"])
	if teslErrBio != nil {
		return teslrt.RejectShape[User](teslErrBio.Error())
	}
	teslFieldAvatarUrl, teslErrAvatarUrl := teslrt.DecodeStringValue(teslFields["avatarUrl"])
	if teslErrAvatarUrl != nil {
		return teslrt.RejectShape[User](teslErrAvatarUrl.Error())
	}
	teslFieldCreatedAt, teslErrCreatedAt := func(teslRaw any) (teslrt.PosixMillis, error) {
		teslBase, teslErr := teslrt.DecodeIntValue(teslRaw)
		if teslErr != nil {
			return teslrt.PosixMillis{}, teslErr
		}
		return teslrt.PosixMillis{Value: teslBase}, nil
	}(teslFields["createdAt"])
	if teslErrCreatedAt != nil {
		return teslrt.RejectShape[User](teslErrCreatedAt.Error())
	}
	return teslrt.Accept(User{Id: teslFieldId, Username: teslFieldUsername, EmailAddress: teslFieldEmailAddress, PasswordHash: teslFieldPasswordHash, Bio: teslFieldBio, AvatarUrl: teslFieldAvatarUrl, CreatedAt: teslFieldCreatedAt})
}

