func teslCacheDecodeUserProfileCache(teslRaw any) (User, error) {
	return func(teslRaw any) (User, error) {
		teslNested := DecodeUserJSON(teslRaw)
		if !teslNested.OK() {
			return User{}, errors.New(teslNested.Message())
		}
		teslValue, _ := teslNested.Value()
		return teslValue, nil
	}(teslRaw)
}

