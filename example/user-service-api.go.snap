func teslEncode1(teslValue string) any {
	return teslValue
}

func teslEncode2(teslValue teslrt.Int) any {
	return teslValue
}

func teslEncode3(teslValue teslrt.PosixMillis) any {
	return teslEncode2(teslValue.Value)
}

func teslEncode4(teslValue User) any {
	return map[string]any{
		"id":           teslEncode1(teslValue.Id),
		"username":     teslEncode1(teslValue.Username),
		"emailAddress": teslEncode1(teslValue.EmailAddress),
		"passwordHash": teslEncode1(teslValue.PasswordHash),
		"bio":          teslEncode1(teslValue.Bio),
		"avatarUrl":    teslEncode1(teslValue.AvatarUrl),
		"createdAt":    teslEncode3(teslValue.CreatedAt),
	}
}

func teslKeyLessString(teslX, teslY string) bool {
	return (teslX < teslY)
}

func teslScanUser(teslRow pgx.CollectableRow) (User, error) {
	teslValue := User{}
	var teslColumn0 string
	var teslColumn1 string
	var teslColumn2 string
	var teslColumn3 string
	var teslColumn4 string
	var teslColumn5 string
	var teslColumn6 int64
	if teslErr := teslRow.Scan(&teslColumn0, &teslColumn1, &teslColumn2, &teslColumn3, &teslColumn4, &teslColumn5, &teslColumn6); teslErr != nil {
		return teslValue, teslErr
	}
	teslValue.Id = teslColumn0
	teslValue.Username = teslColumn1
	teslValue.EmailAddress = teslColumn2
	teslValue.PasswordHash = teslColumn3
	teslValue.Bio = teslColumn4
	teslValue.AvatarUrl = teslColumn5
	teslValue.CreatedAt = teslrt.PosixMillis{Value: teslrt.FromInt64(teslColumn6)}
	return teslValue, nil
}

