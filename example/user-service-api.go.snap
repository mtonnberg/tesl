var UserServer = teslrt.Server{
	Routes: []teslrt.Route{
		{Method: "POST", Path: "/register", Endpoint: "register"},
		{Method: "POST", Path: "/login", Endpoint: "login"},
		{Method: "GET", Path: "/me", Endpoint: "getProfile"},
		{Method: "PUT", Path: "/me", Endpoint: "updateProfile"},
		{Method: "POST", Path: "/forgot-password", Endpoint: "forgotPassword"},
	},
	Handlers: map[string]teslrt.HandlerFunc{
		"register": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
			teslBodyBytes, teslBodyStatus, teslBodyMessage := teslrt.ReadRequestBody(teslRequest)
