		return teslrt.Reject[NewTodo](teslCheckedTitle.Status(), teslCheckedTitle.Message())
	}
	teslFieldTitle, _ = teslCheckedTitle.Value()
	teslCheckedTitle2 := lengthLessThan30(teslFieldTitle)
	if !teslCheckedTitle2.OK() {
		return teslrt.Reject[NewTodo](teslCheckedTitle2.Status(), teslCheckedTitle2.Message())
	}
	teslFieldTitle, _ = teslCheckedTitle2.Value()
	teslCheckedTitle3 := containsAnA(teslFieldTitle)
	if !teslCheckedTitle3.OK() {
		return teslrt.Reject[NewTodo](teslCheckedTitle3.Status(), teslCheckedTitle3.Message())
	}
	teslFieldTitle, _ = teslCheckedTitle3.Value()
	teslDecoded := NewTodo{Title: teslFieldTitle}
	return teslrt.Accept(teslDecoded)
}

func DecodeNewTodoJSON(teslJSON any) teslrt.Check[NewTodo] {
	var teslFirstFailure teslrt.Check[NewTodo]
	teslHaveFailure := false
	teslResult0 := teslDecodeNewTodoAlt0(teslJSON)
	if teslResult0.OK() {
		return teslResult0
	}
	if !teslResult0.IsShapeMismatch() && !teslHaveFailure {
		teslFirstFailure = teslResult0
		teslHaveFailure = true
	}
	if teslHaveFailure {
		return teslFirstFailure
	}
	return teslrt.Reject[NewTodo](400, "no decode alternative matched")
}

var TodoServer = teslrt.Server{
	Routes: []teslrt.Route{
		{Method: "POST", Path: "/list-test", Endpoint: "listTest"},
		{Method: "POST", Path: "/todos", Endpoint: "createTodo"},
		{Method: "GET", Path: "/todos/mine", Endpoint: "listMyTodos"},
		{Method: "GET", Path: "/todos/mine/open", Endpoint: "listOpenTodos"},
		{Method: "GET", Path: "/todos/:todoId", Endpoint: "getTodo"},
		{Method: "PUT", Path: "/todos/:todoId/complete", Endpoint: "completeTodo"},
	},
	Handlers: map[string]teslrt.HandlerFunc{
		"listTest": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
			teslBodyBytes, teslBodyStatus, teslBodyMessage := teslrt.ReadRequestBody(teslRequest)
			if teslBodyStatus != 0 {
				return teslrt.Fail(teslBodyStatus, teslBodyMessage)
			}
			teslBodyText := string(teslBodyBytes)
			teslAuth := cookieAuth(teslrt.NewHttpRequest(teslRequest, teslBodyText))
			if !teslAuth.OK() {
				return teslrt.Fail(teslAuth.Status(), teslAuth.Message())
			}
			requestUser, _ := teslAuth.Value()
			if teslStatus, teslMessage := teslrt.CheckJSONPayload(teslRequest, teslBodyBytes); teslStatus != 0 {
				return teslrt.Fail(teslStatus, teslMessage)
			}
			teslParsed, teslParseErr := teslrt.ParseJSON(teslBodyBytes)
			if teslParseErr != nil {
				return teslrt.Fail(400, "Malformed JSON payload")
			}
			teslBody, teslBodyDecodeErr := teslrt.DecodeListValue(teslParsed, teslrt.DecodeStringValue)
			if teslBodyDecodeErr != nil {
				return teslrt.Fail(400, teslBodyDecodeErr.Error())
			}
			return teslrt.Response{Status: 200, Body: teslEncode2(listTest(requestUser, teslBody))}
		},
		"createTodo": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
			teslBodyBytes, teslBodyStatus, teslBodyMessage := teslrt.ReadRequestBody(teslRequest)
			if teslBodyStatus != 0 {
				return teslrt.Fail(teslBodyStatus, teslBodyMessage)
			}
			teslBodyText := string(teslBodyBytes)
			teslAuth := cookieAuth(teslrt.NewHttpRequest(teslRequest, teslBodyText))
			if !teslAuth.OK() {
				return teslrt.Fail(teslAuth.Status(), teslAuth.Message())
			}
			requestUser, _ := teslAuth.Value()
			if teslStatus, teslMessage := teslrt.CheckJSONPayload(teslRequest, teslBodyBytes); teslStatus != 0 {
				return teslrt.Fail(teslStatus, teslMessage)
			}
			teslParsed, teslParseErr := teslrt.ParseJSON(teslBodyBytes)
			if teslParseErr != nil {
				return teslrt.Fail(400, "Malformed JSON payload")
			}
			teslDecoded := DecodeNewTodoJSON(teslParsed)
			if !teslDecoded.OK() {
				return teslrt.Fail(teslDecoded.Status(), teslDecoded.Message())
			}
			teslBody, _ := teslDecoded.Value()
			return teslrt.Response{Status: 200, Body: teslEncode6(createTodo(requestUser, teslBody))}
		},
		"listMyTodos": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
			teslBodyBytes, teslBodyStatus, teslBodyMessage := teslrt.ReadRequestBody(teslRequest)
			if teslBodyStatus != 0 {
				return teslrt.Fail(teslBodyStatus, teslBodyMessage)
			}
			teslBodyText := string(teslBodyBytes)
			teslAuth := cookieAuth(teslrt.NewHttpRequest(teslRequest, teslBodyText))
			if !teslAuth.OK() {
				return teslrt.Fail(teslAuth.Status(), teslAuth.Message())
			}
			requestUser, _ := teslAuth.Value()
			return teslrt.Response{Status: 200, Body: teslEncode7(listMyTodos(requestUser))}
		},
		"listOpenTodos": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
			teslBodyBytes, teslBodyStatus, teslBodyMessage := teslrt.ReadRequestBody(teslRequest)
			if teslBodyStatus != 0 {
				return teslrt.Fail(teslBodyStatus, teslBodyMessage)
			}
			teslBodyText := string(teslBodyBytes)
			teslAuth := cookieAuth(teslrt.NewHttpRequest(teslRequest, teslBodyText))
			if !teslAuth.OK() {
