		},
		"getTodo": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
			teslBodyBytes, teslBodyStatus, teslBodyMessage := teslrt.ReadRequestBody(teslRequest)
			if teslBodyStatus != 0 {
				return teslrt.Fail(teslBodyStatus, teslBodyMessage)
			}
			teslBodyText := string(teslBodyBytes)
			teslAuth := cookieAuth(teslrt.NewHttpRequest(teslRequest, teslBodyText))
			if !teslAuth.OK() {
				return teslrt.Fail(teslAuth.Status(), teslAuth.Message())
			}
			requestUser, _ := teslAuth.Value()
			todoId, teslFoundTodoId := teslrt.PathParam("/todos/:todoId", teslRequest.URL.Path, "todoId")
			if !teslFoundTodoId {
				return teslrt.Fail(404, "not found")
			}
			teslCapturedTodoId := isTodoId(todoId)
			if !teslCapturedTodoId.OK() {
				return teslrt.Fail(teslCapturedTodoId.Status(), teslCapturedTodoId.Message())
			}
			todoId, _ = teslCapturedTodoId.Value()
			return teslrt.Response{Status: 200, Body: teslEncode6(getTodo(requestUser, todoId))}
		},
		"completeTodo": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
