func teslEncode1(teslValue string) any {
	return teslValue
}

func teslEncode2(teslValue teslrt.Int) any {
	return teslValue
}

func teslEncode3(teslValue teslrt.PosixMillis) any {
	return teslEncode2(teslValue.Value)
}

func teslEncode4(teslValue RoomEvent) any {
	return func() any {
		switch teslValue.Tag {
		case RoomEventNewMessage:
			return map[string]any{"tag": "NewMessage", "fields": map[string]any{
				"msgId":     teslEncode1(teslValue.NewMessage.MsgId),
				"userId":    teslEncode1(teslValue.NewMessage.UserId),
				"username":  teslEncode1(teslValue.NewMessage.Username),
				"content":   teslEncode1(teslValue.NewMessage.Content),
				"createdAt": teslEncode3(teslValue.NewMessage.CreatedAt),
			}}
		case RoomEventUserJoined:
			return map[string]any{"tag": "UserJoined", "fields": map[string]any{
				"userId":   teslEncode1(teslValue.UserJoined.UserId),
				"username": teslEncode1(teslValue.UserJoined.Username),
			}}
		case RoomEventNotifyFailed:
			return map[string]any{"tag": "NotifyFailed", "fields": map[string]any{
				"senderName": teslEncode1(teslValue.NotifyFailed.SenderName),
				"roomName":   teslEncode1(teslValue.NotifyFailed.RoomName),
			}}
		}
		panic("unreachable: checker guarantees case exhaustiveness")
	}()
}

func teslEncode5(teslValue ChatUser) any {
	return map[string]any{
		"id":       teslEncode1(teslValue.Id),
		"username": teslEncode1(teslValue.Username),
	}
}

func teslEncode6(teslValue Room) any {
	return map[string]any{
		"id":        teslEncode1(teslValue.Id),
		"name":      teslEncode1(teslValue.Name),
		"createdAt": teslEncode3(teslValue.CreatedAt),
	}
}

func teslEncode7(teslValue []Room) any {
	return func() any {
		teslOut := make([]any, len(teslValue))
		for teslAt, teslItem := range teslValue {
			teslOut[teslAt] = teslEncode6(teslItem)
		}
		return teslOut
	}()
}

func teslEncode8(teslValue Message) any {
	return map[string]any{
		"id":        teslEncode1(teslValue.Id),
		"roomId":    teslEncode1(teslValue.RoomId),
		"userId":    teslEncode1(teslValue.UserId),
		"username":  teslEncode1(teslValue.Username),
		"content":   teslEncode1(teslValue.Content),
		"createdAt": teslEncode3(teslValue.CreatedAt),
	}
}

func teslEncode9(teslValue []Message) any {
	return func() any {
		teslOut := make([]any, len(teslValue))
		for teslAt, teslItem := range teslValue {
			teslOut[teslAt] = teslEncode8(teslItem)
		}
		return teslOut
	}()
}

func teslKeyLessString(teslX, teslY string) bool {
	return (teslX < teslY)
}

func teslScanChatUser(teslRow pgx.CollectableRow) (ChatUser, error) {
	teslValue := ChatUser{}
	var teslColumn0 string
	var teslColumn1 string
	if teslErr := teslRow.Scan(&teslColumn0, &teslColumn1); teslErr != nil {
		return teslValue, teslErr
	}
	teslValue.Id = teslColumn0
	teslValue.Username = teslColumn1
	return teslValue, nil
}

func teslScanMessage(teslRow pgx.CollectableRow) (Message, error) {
	teslValue := Message{}
	var teslColumn0 string
	var teslColumn1 string
	var teslColumn2 string
	var teslColumn3 string
	var teslColumn4 string
	var teslColumn5 int64
	if teslErr := teslRow.Scan(&teslColumn0, &teslColumn1, &teslColumn2, &teslColumn3, &teslColumn4, &teslColumn5); teslErr != nil {
		return teslValue, teslErr
	}
	teslValue.Id = teslColumn0
	teslValue.RoomId = teslColumn1
	teslValue.UserId = teslColumn2
	teslValue.Username = teslColumn3
	teslValue.Content = teslColumn4
	teslValue.CreatedAt = teslrt.PosixMillis{Value: teslrt.FromInt64(teslColumn5)}
	return teslValue, nil
}

func teslScanRoom(teslRow pgx.CollectableRow) (Room, error) {
	teslValue := Room{}
	var teslColumn0 string
	var teslColumn1 string
	var teslColumn2 int64
	if teslErr := teslRow.Scan(&teslColumn0, &teslColumn1, &teslColumn2); teslErr != nil {
		return teslValue, teslErr
	}
	teslValue.Id = teslColumn0
	teslValue.Name = teslColumn1
	teslValue.CreatedAt = teslrt.PosixMillis{Value: teslrt.FromInt64(teslColumn2)}
	return teslValue, nil
}

