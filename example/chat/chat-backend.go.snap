// teslResetTestState empties the stores every test block starts from, so no block
// inherits another's rows, jobs, or outbound-HTTP stubs.
func teslResetTestState() {
	teslrt.ResetChannel(RoomMessagesChannel)
	teslrt.ResetQueue(NotificationQueueQueue)
	teslrt.TableTruncate(ChatUserTable)
	teslrt.TableTruncate(MessageTable)
	teslrt.TableTruncate(RoomTable)
}
