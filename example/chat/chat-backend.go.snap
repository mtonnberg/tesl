//line chat-backend.tesl:545
func Main() struct{} {
//line chat-backend.tesl:545
	return func() struct{} {
		var teslBound struct{}
		teslrt.WithDatabase(ChatDatabaseDatabase, func() {
			teslBound = (func() struct{} {
				_ = teslrt.InitTelemetry("chat-backend", "in-memory", true, true, false, 60000, 1.0)
				port := teslrt.EnvInt("CHAT_PORT", teslrt.FromInt64(3000))
				_ = port
				_ = teslrt.StartWorkers(NotificationQueueQueue, func(teslPayload any) teslrt.JobOutcome {
					switch teslJob := teslPayload.(type) {
					case NotifyJob:
						_ = notifyWorker(teslJob)
					default:
						panic("NotificationQueue: unexpected job payload")
					}
					return teslrt.JobOutcome{OK: true}
				}, 3, false)
				_ = teslrt.StartWorkers(NotificationQueueQueue, func(teslPayload any) teslrt.JobOutcome {
					switch teslJob := teslPayload.(type) {
					case NotifyJob:
						_ = handleDeadNotify(teslJob)
					default:
						panic("NotificationQueue: unexpected job payload")
					}
					return teslrt.JobOutcome{OK: true}
				}, 3, true)
				return teslrt.Serve(ChatServer, teslrt.ServeOptions{Port: teslrt.PortOf(port), StaticDir: "example/chat/frontend"})
			}())
		})
		return teslBound
	}()
}

