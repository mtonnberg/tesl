//line lesson35-list-decomposition.tesl:211
	if teslLeft24.Tag != teslRight24.Tag || (teslLeft24.Tag == teslrt.MaybeSomething && !teslrt.Equal(teslLeft24.SomethingValue, teslRight24.SomethingValue)) {
