		teslT.Skip("test kind filter")
	}
	teslLeft33 := DescribeList([]teslrt.Int{})
//line lesson35-list-decomposition.tesl:286
	if teslLeft33 != "empty" {
		teslT.Fatal("Tesl expectation failed")
	}
	teslLeft34 := DescribeList([]teslrt.Int{teslrt.FromInt64(1)})
//line lesson35-list-decomposition.tesl:287
	if teslLeft34 != "one element" {
		teslT.Fatal("Tesl expectation failed")
	}
	teslLeft35 := DescribeList([]teslrt.Int{teslrt.FromInt64(1), teslrt.FromInt64(2)})
//line lesson35-list-decomposition.tesl:288
	if teslLeft35 != "exactly two elements" {
		teslT.Fatal("Tesl expectation failed")
	}
	teslLeft36 := DescribeList([]teslrt.Int{teslrt.FromInt64(1), teslrt.FromInt64(2), teslrt.FromInt64(3)})
//line lesson35-list-decomposition.tesl:289
	if teslLeft36 != "three or more elements" {
		teslT.Fatal("Tesl expectation failed")
	}
	teslLeft37 := DescribeList([]teslrt.Int{teslrt.FromInt64(1), teslrt.FromInt64(2), teslrt.FromInt64(3), teslrt.FromInt64(4), teslrt.FromInt64(5)})
//line lesson35-list-decomposition.tesl:290
	if teslLeft37 != "three or more elements" {
		teslT.Fatal("Tesl expectation failed")
	}
}
