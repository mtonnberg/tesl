module Lesson64PasswordStorage exposing [
  registerAccount,
  sessionFor,
  passwordHashFor,
  changePassword,
  logIn,
  needsStrongerHash,
  freshResetToken,
  resetTokenLookupKey,
]

# lesson: track=stdlib order=320 needs=lesson05-intro-to-proofs
# summary: Store and verify a password safely in two calls, with no cryptographic choices left to get wrong
# ─────────────────────────────────────────────
# QUICK START — storing a password, safely, without knowing any cryptography
# ─────────────────────────────────────────────
# Two calls. That is the whole surface:
#
#   Crypto.hashPassword plaintext                  # -> PasswordHash (store this)
#   check Crypto.checkPassword stored candidate     # -> a proof, or 401
#
# There is no algorithm to pick, no work factor, no salt, no encoding and no
# length. Every one of those is a place where a non-expert makes a wrong call and
# gets a plausible-looking result, so none of them reaches you. Underneath it is
# libsodium's `crypto_pwhash` — Argon2id, with libsodium's own recommended
# parameters, unmodified. `tesl doc Crypto.hashPassword` says exactly that:
# friendly names hide the CHOICE, never the FACT.
#
# THREE things the compiler does here that a library cannot:
#
#   1. Storing the hash of the WRONG password does not compile. See
#      `changePassword` below — that is what the `HashFor` fact is for.
#   2. A `PasswordHash` has no `==`, cannot be interpolated into a string, and
#      has no `.value`. Its only legitimate use is a verification, so that is the
#      only thing the type permits. It goes into a column and comes back out; it
#      never becomes a String on the way.
#   3. It is redacted in telemetry, in structured logs and in all three debugger
#      surfaces. You cannot leak it by accident.
#
# AND ONE thing you get for free by never choosing parameters: when Tesl upgrades
# libsodium, every NEW hash is automatically stronger, `needsRehash` starts
# answering True for the old ones, and code that was correct stays correct with no
# edit. That is the payoff for having no knobs.

import Tesl.Prelude exposing [Bool(..), String]
import Tesl.String exposing [String.length]
import Tesl.Maybe exposing [Maybe(..)]
import Tesl.Random exposing [random]
import Tesl.DB exposing [dbRead, dbWrite]
import Tesl.Database exposing [Database, Memory]
import Tesl.Crypto exposing [
  PasswordHash,
  HashFor,
  PasswordVerified,
  Crypto.hashPassword,
  Crypto.checkPassword,
  Crypto.needsRehash,
  Crypto.randomToken,
  Crypto.fingerprint,
]

# `hashPassword` and `randomToken` draw randomness, so they need the `random`
# capability — the SAME one `randomInt` uses. Nothing about crypto introduces a
# new capability: a capability marks an EFFECT, and sensitivity is carried by the
# types and the proofs instead.
capability accountWrite implies dbWrite, random

# ─────────────────────────────────────────────
# A password hash is an ordinary column
# ─────────────────────────────────────────────
# `passwordHash: PasswordHash` stores as text, exactly like any other newtype
# column (lesson67). Storage is not rendering: the column holds the real value,
# because otherwise you could never verify against it. Redaction covers every
# place a value gets DISPLAYED — logs, traces, the debugger — not where it is
# stored.

entity Account table "accounts" primaryKey id {
  id: String
  email: String
  passwordHash: PasswordHash
}

database Accounts = Database {
  entities: [Account]
  backend: Memory
}

# ─────────────────────────────────────────────
# 1. Registration — the easy case
# ─────────────────────────────────────────────
# Only one password is in scope, so nothing can be mixed up.

fn registerAccount(id: String, email: String, password: String) requires [accountWrite] -> Bool =
  let hash = Crypto.hashPassword password
  with database Accounts {
    let _ = insert Account { id: id, email: email, passwordHash: hash }
    True
  }

# ─────────────────────────────────────────────
# 2. Reading the stored hash — note the return type
# ─────────────────────────────────────────────
# `Maybe PasswordHash`, not `PasswordHash`. Keep the `Maybe` and hand it straight
# to `checkPassword`; section 4 explains why that is not just tidiness.

fn passwordHashFor(email: String) requires [dbRead] -> Maybe PasswordHash =
  with database Accounts {
    let found = selectOne a from Account where a.email == email
    case found of
      Nothing -> Nothing
      Something acct -> Something acct.passwordHash
  }

# ─────────────────────────────────────────────
# 3. Change password — where `HashFor` earns its place
# ─────────────────────────────────────────────
# THIS is the handler where password storage actually goes wrong, and it is worth
# understanding why.
#
# Two `String`s are in scope with the same type and adjacent names, and only one
# of them is the answer. The type system cannot help: `oldPassword` and
# `newPassword` are both just `String`. Nor can a test, reliably — hashing the old
# password produces a perfectly valid hash, the write succeeds, and the bug
# surfaces later as "I changed my password and my OLD one still works".
# Password-reset is the same shape with three candidates (`resetToken`,
# `newPassword`, `confirmPassword`), and both handlers are the ones exercised
# least.
#
# `Crypto.hashPassword` returns `PasswordHash ::: HashFor plaintext` — a hash that
# REMEMBERS which string it is the hash of. The storing function demands that the
# two agree, and now the mistake is a compile error:

fn storeNewPassword(
  email: String,
  newPassword: String,
  hash: PasswordHash ::: HashFor newPassword
) requires [dbWrite] -> Bool =
  with database Accounts {
    let _ = update a in Account
      where a.email == email
      set a.passwordHash = hash
    True
  }

# ✅ This compiles. Note that it verifies the OLD password first — a
#    change-password endpoint that does not is a session-hijack escalation, and
#    `check` makes it one line.
fn changePassword(email: String, oldPassword: String, newPassword: String) requires [accountWrite, dbRead] -> Bool =
  let stored = passwordHashFor email
  # Here the check is used for its FAILURE, not its value: reaching the next line
  # at all is the guarantee. `_verified` says "deliberately unused" to the linter.
  let _verified = check Crypto.checkPassword stored oldPassword
  let hash = Crypto.hashPassword newPassword
  storeNewPassword email newPassword hash

# ❌ This does NOT compile — try it. Change `newPassword` to `oldPassword` on the
#    `Crypto.hashPassword` line above and the compiler says:
#
#      error[V001]: call to `storeNewPassword` argument `hash` does not
#      statically satisfy declared proof `HashFor newPassword`
#      Hint: validate `hash` with a check function that establishes
#      `HashFor newPassword` (`hash` is derived from `oldPassword` — same GDP
#      subject)
#
#    In Tesl, storing the hash of the wrong password is a compile error.

# ─────────────────────────────────────────────
# 4. Logging in — and why `checkPassword` takes a `Maybe`
# ─────────────────────────────────────────────
# The obvious code — look the user up, and verify only if a row came back — is
# subtly broken. A missing user returns in microseconds while an existing one
# costs ~80 ms of deliberate work, so the login endpoint tells an attacker exactly
# which email addresses are registered. Passing the `Maybe` straight in means
# `checkPassword` hashes against a dummy when there is no row: both answers cost
# the same and return the same message. You never have to know this problem
# exists, which is the point.

# The proof is only worth minting if something DEMANDS it. This is that
# something: `sessionFor` cannot be called with an unverified value, so
# "issued a session without checking the password" is a compile error rather
# than a code-review question.
fn sessionFor(
  email: String,
  verified: Maybe PasswordHash ::: PasswordVerified verified
) -> String =
  email

fn logIn(email: String, submitted: String) requires [dbRead] -> String =
  let stored = passwordHashFor email
  # `check` is what turns "did the password match?" into a PROOF. On failure it
  # short-circuits with a 401 whose message is identical whether the user was
  # missing or the password was wrong.
  let verified = check Crypto.checkPassword stored submitted
  # `verified` carries `PasswordVerified verified`. Delete the `check` line and
  # this call stops compiling — which is the entire reason verification returns a
  # proof instead of a Bool. A Bool can be ignored, inverted, or compared with
  # `==`; a fact cannot.
  sessionFor email verified

# ─────────────────────────────────────────────
# 5. Upgrade-on-login
# ─────────────────────────────────────────────
# A hash is one-way, so there is no function from a stored hash to a stronger one
# — the plaintext exists for exactly one moment, the next successful login. That
# is why upgrade-on-login is not the weaker option; it is the only mechanism.
#
# Tesl deliberately does NOT do the re-write for you: a crypto function writing to
# your database would be a hidden effect and would couple this module to your data
# model. It is one explicit line in the handler:
#
#   if needsStrongerHash email then changePassword email submitted submitted else …
#
# Verification accepts every scheme ever shipped, because the algorithm and its
# parameters live inside each stored value. So old and new instances read the same
# rows during a rolling deploy: no flag day, no dual-write window, and never a
# bulk rewrite at startup.

fn needsStrongerHash(email: String) requires [dbRead] -> Bool =
  case passwordHashFor email of
    Nothing -> False
    Something hash -> Crypto.needsRehash hash

# ─────────────────────────────────────────────
# 6. Tokens you hand out — never store the token itself
# ─────────────────────────────────────────────
# `randomToken` has no length parameter, on purpose: a caller who can pass `4`
# will. It is 256 bits from the OS CSPRNG, base64url-encoded, so it is safe in a
# URL, a header or a cookie.
#
# THE RULE: send the token, store only its `fingerprint`. Then a database leak
# cannot be replayed, because what you stored is not what the client presents.
# This is also the answer to "how do I give someone an API key?" — you are not
# holding a secret you must protect, you are minting a token you can forget.

fn freshResetToken() requires [accountWrite] -> String =
  Crypto.randomToken()

fn resetTokenLookupKey(token: String) -> String =
  Crypto.fingerprint token

# ─────────────────────────────────────────────
# WHAT THIS LESSON DOES NOT DO
# ─────────────────────────────────────────────
# It does not authenticate anybody. `PasswordVerified` proves that a password was
# checked against a stored hash; going from there to "this request is user 42"
# still needs an explicit `establish`. What the proof buys is that the unverified
# step becomes small, explicit and reviewable — one `establish` beside a real
# verification — instead of an `auth` body that never verified anything at all.
#
# In particular: reading a cookie and trusting its value is NOT authentication, no
# matter how the result is annotated. See lesson06 and lesson57 (JWT).

test "a registered password verifies" requires [accountWrite, dbRead] {
  let _ = registerAccount "u1" "ada@example.com" "correct horse battery staple"
  expect logIn "ada@example.com" "correct horse battery staple" == "ada@example.com"
}

test "a hash minted with the current parameters does not need rehashing" requires [accountWrite, dbRead] {
  let _ = registerAccount "u2" "grace@example.com" "hopper"
  expect needsStrongerHash "grace@example.com" == False
}

test "an unknown email reports no stored hash and needs no rehash" requires [dbRead] {
  expect needsStrongerHash "nobody@example.com" == False
}

test "change-password stores a hash of the NEW password" requires [accountWrite, dbRead] {
  let _ = registerAccount "u3" "linus@example.com" "old-one"
  let _ = changePassword "linus@example.com" "old-one" "new-one"
  # The NEW password now verifies. (Asserting that the old one no longer does
  # would mean expecting a 401 — a handler-level concern; see lesson55.)
  expect logIn "linus@example.com" "new-one" == "linus@example.com"
}

test "a reset token is unguessable, URL-safe, and stored only as a fingerprint" requires [accountWrite] {
  let token = freshResetToken()
  # 32 bytes, base64url, no padding = 43 characters
  expect String.length token == 43
  expect resetTokenLookupKey token == Crypto.fingerprint token
  # two draws from a 256-bit space are never equal
  let another = freshResetToken()
  expect (token == another) == False
}
