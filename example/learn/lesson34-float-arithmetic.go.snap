		if teslTrap := recover(); teslTrap != nil {
			teslT.Fatalf("Tesl test trapped: %v", teslTrap)
		}
	}()
	teslLeft22 := teslrt.FloatRound(teslrt.FloatAbs(float64(-2.5)))
//line lesson34-float-arithmetic.tesl:229
	if !teslrt.Equal(teslLeft22, teslrt.FromInt64(2)) {
//line lesson34-float-arithmetic.tesl:229
