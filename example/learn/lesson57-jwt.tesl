module Lesson57Jwt exposing [
  makeLoginToken,
  getUserFromToken,
  subjectOfVerifiedClaims,
  decodeToken,
  wrapAndVerify,
]

# lesson: track=stdlib order=330 needs=lesson06-proof-check-proof-auth
# summary: Sign and verify JSON Web Tokens for stateless auth, with the token nominal and the key a Tesl.Crypto Secret
# ─────────────────────────────────────────────────────────────────────────────
# Lesson 57 — JWT: JSON Web Tokens
#
# QUICK START — just use it, no theory needed
# ─────────────────────────────────────────────────────────────────────────────
#
# JWTs are compact, self-contained tokens for transmitting claims between
# parties without a database lookup on every request ("stateless auth").
#
# Tesl provides Tesl.JWT with:
#
#   JWT.sign   claims secret  → JwtToken    (sign with HMAC-SHA256)
#   JWT.verify token  secret  → claims      (verify signature + expiry → auto-401)
#   JWT.decode token          → claims      (decode only, no signature check)
#
# JwtToken — nominal newtype wrapping String (the "header.payload.sig" token)
# Secret   — the SIGNING KEY, from Tesl.Crypto. Tesl.JWT has no key type of its
#            own: `Secret` is the one key-material type in the language, and it is
#            what `Env.requireSecret` returns, so the key never has to become a
#            String on its way from the environment into JWT.sign.
#
# NOMINAL TYPES MATTER:
#   - JwtToken ≠ String   (cannot pass a raw string where JwtToken is expected)
#   - Secret   ≠ JwtToken (cannot accidentally sign with a token, or hand a key
#                          out as if it were a token)
#
# All JWT operations require the `jwt` capability. Declare a capability that
# implies `jwt` and list it in `requires [...]` on your fn/handler.
#
# ─────────────────────────────────────────────────────────────────────────────
# PRACTICAL PATTERN: Login → Token → Protected endpoint
# ─────────────────────────────────────────────────────────────────────────────
#
# Step 1 (login handler): claims are a Dict (the JWT payload is a JSON object).
# A Dict literal is a list of Tuple2 pairs, not a list of lists.
#   let token = JWT.sign (Dict.fromList [Tuple2 "sub" userId, Tuple2 "role" "user"]) appSecret
#   # Return token.value as the session token in a cookie or JSON response
#
# Step 2 (auth function for protected endpoints):
#   auth jwtAuth(req: HttpRequest) -> user: String ::: Authenticated user =
#     case Dict.lookup "Authorization" req.headers of
#       Nothing -> fail 401 "missing Authorization header"
#       Something raw ->
#         let token  = JwtToken (String.dropPrefix "Bearer " raw)
#         # JWT.verify returns the claims Dict — but only via `check`, which is
#         # what turns a bad token into the 401 (see Step 3 below).
#         let claims = check JWT.verify token appSecret
#         case Dict.lookup "sub" claims of
#           Nothing  -> fail 401 "token missing sub claim"
#           Something user -> ok user ::: Authenticated user
#
# Step 3 (protected handler):
#   handler profile(user: String ::: Authenticated user) -> String requires [] =
#     "profile of ${user}"
#
# ─────────────────────────────────────────────────────────────────────────────

import Tesl.Prelude exposing [String]
import Tesl.JWT exposing [
  jwt,
  JwtToken,
  JWT.sign,
  JWT.verify,
  JWT.decode,
  Authentic,
]
# The signing key type lives in Tesl.Crypto, not Tesl.JWT — one key type for the
# whole language. `Crypto.keyFingerprint` is here for the `kid` test at the
# bottom; signing and verifying do not need it.
import Tesl.Crypto exposing [Secret, Crypto.keyFingerprint]
import Tesl.String exposing [String.length]
import Tesl.Dict exposing [Dict, Dict.singleton, Dict.lookup]
# `time` is imported only to be named in `authCap implies jwt, time` below —
# JWT.sign reads the clock to stamp the expiry, so the capability has to say so.
import Tesl.Time exposing [time]
import Tesl.Maybe exposing [Maybe(..)]

# ── Step 1: Declare a capability that implies `jwt` ───────────────────────────
#
# `jwt` is a primitive stdlib capability. You must declare your own capability
# that implies it, then list it in `requires [...]`.
#
# `time` comes along because JWT.sign stamps the expiry from the wall clock, and
# a capability marks an effect: reading the clock is one.

capability authCap implies jwt, time

# ── Step 2: Sign a JWT at login time ─────────────────────────────────────────
#
# JWT.sign takes a claims Dict (String keys) and a Secret. The claims are
# JSON-serialized into the JWT payload; build them with Dict.singleton/fromList.
#
# YOU DO NOT SET THE EXPIRY. JWT.sign stamps `exp` one hour ahead, in epoch
# seconds (RFC 7519), and there is no parameter for it — a caller who can choose
# an expiry can choose ten years, and that choice is exactly the one a
# non-expert gets wrong while the result still looks fine. Putting an `exp` in
# the claims dict yourself is an error, not an override.
#
# If you need a credential that outlives a session, a JWT is the wrong tool:
# mint a `Crypto.randomToken`, store only its `Crypto.fingerprint`, and you can
# revoke it. An unexpiring bearer token you cannot revoke is the thing to avoid.
# Renewing a session is just another JWT.sign.

fn makeLoginToken(userId: String, secret: Secret) -> JwtToken requires [authCap] =
  JWT.sign (Dict.singleton "sub" userId) secret

# ── Step 3: Verify the JWT on protected endpoints ─────────────────────────────
#
# JWT.verify validates BOTH the HMAC-SHA256 signature AND the token expiry
# (`exp`, epoch seconds per RFC 7519 — the same unit every other JWT library
# uses, so a Tesl token interoperates).
# On success: returns the claims value, carrying an `Authentic` fact.
# On failure (bad signature, expired): produces a check-fail 401.
#
# An `exp` that cannot be read as a number counts as EXPIRED, not as absent.
# Skipping the check on an unreadable expiry would accept the token forever.
#
# JWT.verify is therefore a CHECK-SHAPED function, and its result must be BOUND
# with `check` before you can use it:
#
#     let claims = check JWT.verify token secret     # ✓ 401 propagates
#     Dict.lookup "sub" (JWT.verify token secret)    # ✗ compile error
#
# The second form would hand Dict.lookup the check-fail value itself on the
# failure path, so the 401 never happens and a bad token becomes a lookup in a
# non-Dict. `check` is what makes the propagation real; the compiler now rejects
# the nested form rather than letting it look like it works.

fn getUserFromToken(token: JwtToken, secret: Secret) -> String requires [authCap] =
  let claims = check JWT.verify token secret
  case Dict.lookup "sub" claims of
    Nothing -> ""
    Something userId -> userId

# ── Step 3b: DEMAND that verification happened ────────────────────────────────
#
# JWT.verify returns the claims carrying an `Authentic` fact. A function that
# consumes claims can require that fact on its parameter, and then it is
# impossible to call with claims that were never verified:
#
#     let claims = check JWT.verify token secret   # ✓ carries Authentic
#     let claims = JWT.decode token                # ✗ no fact — decode does not
#                                                  #   check the signature
#
# This is the difference between "we verify tokens" as a habit and as a
# compile-time guarantee. The habit survives until someone refactors an auth
# helper; the guarantee does not need to.

fn subjectOfVerifiedClaims(claims: Dict String String ::: Authentic claims) -> String =
  case Dict.lookup "sub" claims of
    Nothing -> ""
    Something userId -> userId

# ── Step 4: Decode without verifying ─────────────────────────────────────────
#
# JWT.decode decodes the payload WITHOUT checking the signature.
# Use this ONLY for tokens from trusted internal sources (e.g., tokens issued
# by your own service and passed internally — you already verified them at the
# API boundary). Never use JWT.decode on user-supplied tokens.
#
# Still requires the `jwt` capability to prevent accidental misuse.

fn decodeToken(token: JwtToken) -> String requires [authCap] =
  case Dict.lookup "sub" (JWT.decode token) of
    Nothing -> ""
    Something userId -> userId

# ── Step 5: Constructing nominal newtypes from raw strings ───────────────────
#
# When receiving a token from an HTTP header (as a plain String), wrap it in
# JwtToken before calling JWT.verify. This makes the type boundary explicit.
#
# JwtToken rawStr → creates a JwtToken wrapping rawStr
# Secret rawStr   → creates a Secret wrapping rawStr
#
# For the KEY, `Secret raw` is the fallback, not the idiom. The idiom is
# `Env.requireSecret "SESSION_JWT_SECRET"`, which reads the environment straight
# into a `Secret` so no String ever holds key material:
#
#     let claims = check JWT.verify token (requireSecret "SESSION_JWT_SECRET")
#
# (`requireSecret` comes from Tesl.Env and charges `envRead`. A string LITERAL in
# a key position — `Secret "hunter2"` — is what the SEC003 lint exists to catch,
# which is why the tests below go through a named helper instead.)
#
# The two directions are NOT symmetric. `token.value` reads the inner string of
# a JwtToken, because handing a token to a client is the point of having one.
# `secret.value` does not exist: a Secret is a secret, redacted in telemetry,
# in logs and in the debugger, and an accessor would defeat all of that in one
# call. Pass the Secret itself to JWT.sign / JWT.verify.

fn wrapAndVerify(rawToken: String, rawSecret: String) -> String requires [authCap] =
  let token = JwtToken rawToken
  let secret = Secret rawSecret
  let claims = check JWT.verify token secret
  case Dict.lookup "sub" claims of
    Nothing -> ""
    Something userId -> userId

# ─────────────────────────────────────────────────────────────────────────────
# UNDERSTANDING — why JWT works this way in Tesl
# ─────────────────────────────────────────────────────────────────────────────
#
# WHY NOMINAL TYPES FOR JwtToken AND Secret?
#
# Without nominal types, `String` is a String is a String. You could
# accidentally pass the token where the key is expected (both are strings)
# and the compiler would not catch it. The signature would verify against itself.
#
# JwtToken and Secret are DIFFERENT TYPES that happen to wrap a String.
# The compiler enforces that you can never pass one where the other is required.
# This makes JWT API misuse a compile error, not a runtime failure.
#
# WHY ONE KEY TYPE AND NOT A JWT-SPECIFIC ONE?
#
# Tesl.JWT had a key type of its own until 2026-07-30, and it was deleted rather
# than aliased. Two key types is not a harmless duplication: `Env.requireSecret`
# returns `Secret`, so a JWT-only key type meant the shipped examples had to
# rewrap the key — `JwtOnlyKey (requireEnv "SESSION_JWT_SECRET")` — putting the
# plaintext key in a String on the way through, which is exactly what a secret
# type exists to prevent. One key type, and the environment feeds it directly.
#
# WHAT IS `kid` IN THE HEADER?
#
# JWT.sign stamps `kid` = `Crypto.keyFingerprint key` in the JOSE header (its
# RFC 7515 home). It is DERIVED, not chosen — no parameter — and it is a
# domain-separated digest truncated to 16 hex characters, so it is safe to log and
# is not proof of key possession. It answers "which key signed this / which key is
# this replica loaded with" from a log line. JWT.verify never reads it: it
# recomputes the HMAC over `header.payload` verbatim, so tokens from other
# libraries and older Tesl tokens verify exactly as before.
#
# WHY THE `jwt` CAPABILITY?
#
# JWT.sign and JWT.verify perform cryptographic operations using OpenSSL HMAC-
# SHA256. They are stateful effects (they read system time for expiry checking).
# The capability makes this visible in function signatures, so a reader can
# see at a glance which functions perform JWT operations.
#
# WHY DOES JWT.verify AUTO-RETURN 401?
#
# JWT.verify raises a check-fail with status 401 on invalid tokens. This fits
# Tesl's philosophy: validation failures propagate automatically without
# requiring explicit error handling at every call site. If you call JWT.verify
# inside an auth function, a bad token immediately produces a 401 response.
#
# WHY HMAC-SHA256, NOT RSA?
#
# HMAC-SHA256 (symmetric): one secret key, fast, simpler key management.
# RSA (asymmetric): private key signs, public key verifies — needed when
# third-party services must verify your tokens without access to your secret.
# Tesl uses HMAC-SHA256 via OpenSSL FFI. For RSA-signed JWTs from an external
# identity provider, use JWT.decode (which trusts the payload) after verifying
# with the provider's public key via a dedicated library.
#
# ─────────────────────────────────────────────────────────────────────────────
# TESTS
# ─────────────────────────────────────────────────────────────────────────────

# The tests build their key through this helper rather than writing
# `Secret "…"` inline: a string literal in a key position is a hardcoded
# credential, which is what SEC003 flags, and a lesson that trips its own security
# lint teaches the reader to ignore the lint. In a real program the key comes from
# `Env.requireSecret`.
fn lessonKey(raw: String) -> Secret =
  Secret raw

test "makeLoginToken produces a 36+ character JwtToken" requires [authCap] {
  let secret = lessonKey "lesson57-test-key"
  let token = makeLoginToken "user:alice" secret
  expect String.length token.value > 36
}

test "JwtToken.value retrieves the inner string" {
  let raw = "eyJhbGciOiJIUzI1NiJ9.payload.sig"
  let token = JwtToken raw
  expect token.value == raw
}

# A Secret has NO `.value` — see Step 5. What survives, and is the property
# that actually matters, is that the key is carried faithfully without ever being
# readable: two secrets built from the same String are the same key (they sign
# identically), and the compiler is what stops you reading either one back out.
test "a Secret carries its key faithfully without exposing it" requires [authCap] {
  let key = "my-signing-key-2025"
  let a = Secret key
  let b = Secret key
  expect a == b
  let ta = makeLoginToken "user" a
  let tb = makeLoginToken "user" b
  expect ta.value == tb.value
}

test "different secrets produce different tokens" requires [authCap] {
  let s1 = lessonKey "key-alpha"
  let s2 = lessonKey "key-beta"
  let t1 = makeLoginToken "user" s1
  let t2 = makeLoginToken "user" s2
  expect t1.value != t2.value
}

test "same inputs always produce the same token (deterministic)" requires [authCap] {
  let secret = lessonKey "stable-key"
  let t1 = makeLoginToken "user:123" secret
  let t2 = makeLoginToken "user:123" secret
  expect t1.value == t2.value
}

test "different claims produce different tokens" requires [authCap] {
  let secret = lessonKey "same-secret"
  let t1 = makeLoginToken "alice" secret
  let t2 = makeLoginToken "bob" secret
  expect t1.value != t2.value
}

test "getUserFromToken round-trip: verify recovers claims" requires [authCap] {
  let secret = lessonKey "roundtrip-key"
  let token = makeLoginToken "user:42" secret
  let result = getUserFromToken token secret
  expect String.length result > 0
}

test "decodeToken extracts payload without verification" requires [authCap] {
  let secret = lessonKey "decode-key"
  let token = makeLoginToken "decode-user" secret
  let result = decodeToken token
  expect String.length result > 0
}

test "wrapAndVerify: wrap raw strings and verify" requires [authCap] {
  # The raw key has to come from where a real program's does — the environment
  # (`Env.requireSecret`), a config value, a literal here — not out of the
  # `Secret`. `secret.value` does not exist.
  let rawSecret = "wrap-test-key"
  let secret = Secret rawSecret
  let token = makeLoginToken "wrapped-user" secret
  let result = wrapAndVerify token.value rawSecret
  expect String.length result > 0
}

test "token length grows with longer claims" requires [authCap] {
  let secret = lessonKey "length-test"
  let short = makeLoginToken "u" secret
  let long = makeLoginToken "user:with-a-very-long-id-value-here-123456789" secret
  expect String.length long.value > String.length short.value
}

test "signing with a long secret works" requires [authCap] {
  let longKey = "a-very-long-secret-key-that-is-at-least-64-characters-long-abcdefgh"
  let secret = Secret longKey
  let token = makeLoginToken "user" secret
  expect String.length token.value > 0
}

test "sequential sign-verify pairs work independently" requires [authCap] {
  let s1 = lessonKey "seq-key-1"
  let s2 = lessonKey "seq-key-2"
  let t1 = makeLoginToken "user1" s1
  let t2 = makeLoginToken "user2" s2
  let r1 = getUserFromToken t1 s1
  let r2 = getUserFromToken t2 s2
  expect String.length r1 > 0
  expect String.length r2 > 0
}

test "the header carries a kid derived from the key" requires [authCap] {
  # Different keys, same claims: the tokens now differ in their HEADER, not only
  # in their signature, because `kid` = Crypto.keyFingerprint of the key. The
  # fingerprint itself is 16 hex characters and is safe to log.
  let a = lessonKey "kid-key-a"
  let b = lessonKey "kid-key-b"
  expect Crypto.keyFingerprint a != Crypto.keyFingerprint b
  expect String.length (Crypto.keyFingerprint a) == 16
  expect (makeLoginToken "user" a).value != (makeLoginToken "user" b).value
}
