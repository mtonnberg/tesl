func teslEqualCategory(teslX, teslY Category) bool {
	return ((teslX.Id == teslY.Id) && (teslX.Label == teslY.Label) && (teslX.Active == teslY.Active))
}

func teslEqualProduct(teslX, teslY Product) bool {
	return ((teslX.Id == teslY.Id) && (teslX.Name == teslY.Name) && teslrt.Equal(teslX.Price, teslY.Price) && (teslX.Category == teslY.Category) && (teslX.InStock == teslY.InStock))
}

