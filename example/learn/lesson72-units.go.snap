	if teslWanted := os.Getenv("TESL_TEST_NAME"); teslWanted != "" && teslWanted != "temperature is stored as kelvin; 100 \xc2\xb0C reads back as 212 \xc2\xb0F" && teslWanted != "TestTesl12" {
		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	teslResetTestState()
//line lesson72-units.tesl:381
	if !(ApproxEqual(teslrt.TemperatureInFahrenheit(teslrt.TemperatureCelsius(float64(1e+02))), float64(212))) {
		teslT.Fatal("Tesl expectation failed")
	}
}

func TestTesl13(teslT *testing.T) {
	if teslWanted := os.Getenv("TESL_TEST_NAME"); teslWanted != "" && teslWanted != "Time.add speaks Duration; Time.diff returns one" && teslWanted != "TestTesl13" {
		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	teslResetTestState()
	{
//line lesson72-units.tesl:394
		start := teslrt.SecondsToPosix(teslrt.FromInt64(1000))
		_ = start
		{
//line lesson72-units.tesl:395
			deadline := teslrt.TimeAdd(start, teslrt.DurationHours(float64(2)))
			_ = deadline
			teslLeft18 := teslrt.PosixToSeconds(deadline)
//line lesson72-units.tesl:396
			if !teslrt.Equal(teslLeft18, teslrt.FromInt64(8200)) {
				teslT.Fatal("Tesl expectation failed")
			}
			teslLeft19 := teslrt.DurationInSeconds(teslrt.TimeDiff(start, deadline))
//line lesson72-units.tesl:397
			if !teslrt.FloatEqual(teslLeft19, float64(7.2e+03)) {
				teslT.Fatal("Tesl expectation failed")
			}
			teslLeft20 := teslrt.DurationInMinutes(teslrt.TimeDiff(start, deadline))
//line lesson72-units.tesl:398
			if !teslrt.FloatEqual(teslLeft20, float64(1.2e+02)) {
				teslT.Fatal("Tesl expectation failed")
			}
			teslLeft21 := teslrt.DurationToMillis(teslrt.DurationHours(float64(2)))
//line lesson72-units.tesl:399
			if !teslrt.Equal(teslLeft21, teslrt.FromInt64(7200000)) {
				teslT.Fatal("Tesl expectation failed")
			}
		}
	}
}

// teslResetTestState empties the stores every test block starts from, so no block
// inherits another's rows, jobs, or outbound-HTTP stubs.
func teslResetTestState() {
	teslrt.TableTruncate(VehicleTable)
}
