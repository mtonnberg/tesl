module Lesson55TestingAuthAndCapabilities exposing [AuthServer]

# lesson: track=testing order=240 needs=lesson32-api-tests,lesson11-capabilities
# summary: Test an authenticated endpoint and prove that unauthenticated requests really are rejected
# ─────────────────────────────────────────────────────────────────────────────
# Lesson 55 — Testing Auth and Capabilities
#
# Auth requirements and capabilities can be tested via api-test blocks.
# This lesson shows how to write api-tests for authenticated endpoints and
# how to verify that unauthenticated requests are correctly rejected.
# ─────────────────────────────────────────────────────────────────────────────

import Tesl.Prelude exposing [String, Int]
import Tesl.Http exposing [HttpRequest, Http.sessionToken]
import Tesl.Dict exposing [Dict.lookup, Dict.singleton]
import Tesl.Maybe exposing [Maybe(..)]
import Tesl.ApiTest exposing [statusOk, statusClientError]
import Tesl.DB exposing [dbRead, dbWrite]
import Tesl.JWT exposing [jwt, JWT.sign, JWT.verify]
# The signing key is Tesl.Crypto's `Secret` — one key type for the whole language,
# and the type `Env.requireSecret` returns.
import Tesl.Crypto exposing [Secret]
# `time` is named only in the capability below: JWT.sign stamps the session's
# expiry from the wall clock, so the capability has to admit the clock read.
import Tesl.Time exposing [time]

# ─────────────────────────────────────────────────────────────────────────────
# DOMAIN: A simple authenticated API
#
# The session cookie is a SIGNED token, not a name. A bare cookie-name check is
# not authentication: the client picks the cookie, so `__Host-session=alice`
# would authenticate anyone as alice. JWT.verify recomputes the HMAC-SHA256
# signature and auto-401s unless it matches, so only a token this server minted
# gets in — and test 3 below proves it, because a forged cookie now fails.
# ─────────────────────────────────────────────────────────────────────────────

capability sessionAuthCap implies jwt, time

fact Authenticated (user: String)

# The signing key is written here ONLY so this lesson's api-tests are
# self-contained (they have to mint a valid cookie, which needs the key).
# A real service reads it from the environment and never commits it:
#   requireSecret "SESSION_JWT_SECRET"      # Tesl.Env, returns a Secret
#
# The key goes through `keyFromRaw` rather than being written `Secret "…"`
# directly: a string literal in a key position is a hardcoded credential, which is
# what the SEC003 lint flags, and a lesson that trips its own security lint
# teaches the reader to ignore the lint.
fn keyFromRaw(raw: String) -> Secret = Secret raw

fn lessonSecret() -> Secret = keyFromRaw "lesson55-signing-key-not-for-production"

# What a login handler would hand back as the session cookie value.
fn mintSession(user: String) -> String requires [sessionAuthCap] =
  (JWT.sign (Dict.singleton "sub" user) (lessonSecret())).value

# An attacker CAN produce a well-formed token — what they cannot do is sign it
# with this server's key. Test 5 sends one of these.
fn forgedSession(user: String) -> String requires [sessionAuthCap] =
  (JWT.sign (Dict.singleton "sub" user) (keyFromRaw "an-attackers-own-key")).value

auth sessionAuth(req: HttpRequest) -> user: String ::: Authenticated user
  requires [sessionAuthCap] =
  # `Http.sessionToken` reads the one fixed session cookie name, which lives in
  # the runtime rather than being re-spelled at every call site where a typo
  # would be a permanent 401 no test can tell from a real rejection.
  case Http.sessionToken req of
    Nothing -> fail 401 "not authenticated"
    Something token ->
      # JWT.verify checks the signature and the `exp` claim.  It is check-
      # shaped: on rejection it returns a check-fail carrying the 401, and only
      # `check` unwraps that and propagates it — so bind it with `let x = check
      # …`, never a plain `let` and never nested inside another call.
      let claims = check JWT.verify token (lessonSecret())
      case Dict.lookup "sub" claims of
        Nothing -> fail 401 "not authenticated"
        Something subject -> ok subject ::: Authenticated user

# ─────────────────────────────────────────────────────────────────────────────
# API with both public and authenticated endpoints
# ─────────────────────────────────────────────────────────────────────────────

api AuthApi {
  # Public endpoint — no auth required
  get "/health"
    -> String

  # Authenticated endpoint — requires session cookie
  get "/profile"
    auth user : String ::: Authenticated user via sessionAuth
    -> String
}

handler get health() -> String requires [] = "ok"

handler get profile(user: String ::: Authenticated user) -> String requires [] =
  "profile of ${user}"

server AuthServer for AuthApi {
  health
  profile
}

# ─────────────────────────────────────────────────────────────────────────────
# TESTING
#
# api-test blocks let you write HTTP-level tests against your server.
# For authenticated endpoints, set the session cookie in the request. The name
# `__Host-session` is spelled out here only because a .tesl file cannot reach the
# runtime constant `session-cookie-name` in the HTTP runtime, which is the single
# source of truth `Http.sessionToken` reads.
# ─────────────────────────────────────────────────────────────────────────────

# Test 1: Public endpoint works without authentication
api-test "health endpoint is accessible without auth" for AuthServer {
  let resp = get "/health"
  expect statusOk resp.status
}

# Test 2: Protected endpoint requires authentication
api-test "profile endpoint returns 401 without cookie" for AuthServer requires [sessionAuthCap] {
  let resp = get "/profile"
  expect statusClientError resp.status
}

# Test 3: Protected endpoint works with a SIGNED session cookie
api-test "profile endpoint works with a signed session cookie" for AuthServer requires [sessionAuthCap] {
  let resp = get "/profile" cookie { "__Host-session": mintSession "alice" }
  expect statusOk resp.status
}

# Test 4: A cookie the client simply made up is rejected. This is the test that
# would have PASSED against the old `ok token ::: Authenticated user` version —
# which is exactly why that version was not authentication.
api-test "profile endpoint rejects a made-up cookie value" for AuthServer requires [sessionAuthCap] {
  let resp = get "/profile" cookie { "__Host-session": "alice" }
  expect statusClientError resp.status
}

# Test 5: And a WELL-FORMED token signed with the wrong key is rejected too.
# Test 4 alone would pass against an authenticator that merely required the
# cookie to look like a JWT; only this one exercises the signature check.
api-test "profile endpoint rejects a token signed with the wrong key" for AuthServer requires [sessionAuthCap] {
  let resp = get "/profile" cookie { "__Host-session": forgedSession "alice" }
  expect statusClientError resp.status
}

# ─────────────────────────────────────────────────────────────────────────────
# UNDERSTANDING — what api-tests verify
# ─────────────────────────────────────────────────────────────────────────────
# api-test runs the full HTTP stack: routing, auth, handler, response.
# For authenticated endpoints:
#   - No cookie → auth function returns fail 401 → client error status
#   - Signed cookie → auth function returns ok → handler runs → success
#   - FORGED cookie → signature check fails → 401. Test this one. An auth test
#     suite that only covers "no cookie" and "a cookie" cannot tell an
#     authenticator from a cookie reader.
#
# The compiler wires the auth function to the endpoint automatically.
# If you forget to test the unauthenticated case, the handler might run
# with unverified inputs.  Always test both authenticated AND unauthenticated.
#
# MUTATION TESTING of auth functions:
# Tesl's built-in mutation testing covers `auth` functions — it mutates the
# conditions in the auth function body and runs your tests to verify each
# mutant is killed.  A surviving mutant means your tests don't cover some
# part of the auth logic.
#
# Run mutation testing:
#   tesl test lesson55-testing-auth-and-capabilities.tesl
# (Or use the --mutate flag on the source file directly)
# ─────────────────────────────────────────────────────────────────────────────
