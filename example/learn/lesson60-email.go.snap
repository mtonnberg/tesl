//line lesson60-email.tesl:104
func SendWelcomeEmail(recipientAddr string, firstName string) struct{} {
//line lesson60-email.tesl:106
	return teslrt.SendEmail(AppEmailOutbox, recipientAddr, "Welcome to our service!", teslrt.EmailBody{Tag: teslrt.EmailBodyRich, Text: ("Hello " + firstName + ", welcome! We're glad to have you."), HTML: ("<h1>Welcome, " + firstName + "!</h1><p>Great to have you with us.</p>")})
}

//line lesson60-email.tesl:113
func SendPasswordReset(recipientAddr string, resetLink string) struct{} {
//line lesson60-email.tesl:115
	return teslrt.SendEmail(AppEmailOutbox, recipientAddr, "Password Reset Request", teslrt.EmailBody{Tag: teslrt.EmailBodyRich, Text: ("Click this link to reset your password: " + resetLink), HTML: ("<p>Click <a href=\"" + resetLink + "\">here</a> to reset your password. Link expires in 30 minutes.</p>")})
}

//line lesson60-email.tesl:122
func SendNotification(addr string, message string) struct{} {
//line lesson60-email.tesl:124
	return teslrt.SendEmail(AppEmailOutbox, addr, "Notification", teslrt.EmailBody{Tag: teslrt.EmailBodyText, Text: message})
}

//line lesson60-email.tesl:131
func SendHtmlNewsletter(addr string, htmlContent string) struct{} {
//line lesson60-email.tesl:133
	return teslrt.SendEmail(AppEmailOutbox, addr, "Monthly Newsletter", teslrt.EmailBody{Tag: teslrt.EmailBodyHTML, HTML: htmlContent})
}

//line lesson60-email.tesl:258
func startEmailDelivery() struct{} {
//line lesson60-email.tesl:259
	return teslrt.StartEmailWorker(AppEmailOutbox)
}

