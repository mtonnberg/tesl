}

//line lesson03-records.tesl:57
func Scale(r Rectangle, factor teslrt.Int) Rectangle {
//line lesson03-records.tesl:58
	return Rectangle{Origin: r.Origin, Width: teslrt.Mul(r.Width, factor), Height: teslrt.Mul(r.Height, factor)}
}

