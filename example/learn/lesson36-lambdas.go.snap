		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	defer func() {
		if teslTrap := recover(); teslTrap != nil {
			teslT.Fatalf("Tesl test trapped: %v", teslTrap)
		}
	}()
	teslLeft25 := sumAbove([]teslrt.Int{teslrt.FromInt64(1), teslrt.FromInt64(5), teslrt.FromInt64(3), teslrt.FromInt64(8), teslrt.FromInt64(2)}, teslrt.FromInt64(4))
//line lesson36-lambdas.tesl:191
	if !teslrt.Equal(teslLeft25, teslrt.FromInt64(13)) {
//line lesson36-lambdas.tesl:191
		teslT.Fatal("Tesl expectation failed")
	}
	teslLeft26 := sumAbove([]teslrt.Int{}, teslrt.FromInt64(0))
//line lesson36-lambdas.tesl:192
	if !teslrt.Equal(teslLeft26, teslrt.FromInt64(0)) {
//line lesson36-lambdas.tesl:192
		teslT.Fatal("Tesl expectation failed")
	}
	teslLeft27 := sumAbove([]teslrt.Int{teslrt.FromInt64(1), teslrt.FromInt64(2), teslrt.FromInt64(3)}, teslrt.FromInt64(10))
//line lesson36-lambdas.tesl:193
	if !teslrt.Equal(teslLeft27, teslrt.FromInt64(0)) {
//line lesson36-lambdas.tesl:193
		teslT.Fatal("Tesl expectation failed")
	}
}

func TestTesl11(teslT *testing.T) {
