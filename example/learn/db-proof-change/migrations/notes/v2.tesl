module Schema.Notes.Migrate.V2 exposing [migration, oldNote]
import Tesl.Prelude exposing [String, Bool(..)]
import Tesl.Maybe exposing [Maybe(..)]
import Tesl.Migration exposing [Migration, Entity(..), Rule(..), Migrated(..)]
import Schema.Notes.V1
import Schema.Notes.VCurrent
migration = Migration { from: Schema.Notes.V1, to: Schema.Notes.VCurrent, same: [], fixtures: [oldNote],
 entities: { Note: Migrate convert [Retype title, WriteBack title title backward] } }
fn convert(old: Schema.Notes.V1.Note) -> Migrated Schema.Notes.VCurrent.Note =
case Schema.Notes.VCurrent.tryTitle old.title of
  Nothing -> Reject "title rejected by changed proof"
  Something title -> Row (Schema.Notes.VCurrent.Note { id: old.id, title: title, memo: old.memo })
fn backward(row: Schema.Notes.VCurrent.Note) -> value: String ::: Schema.Notes.V1.NonEmpty value =
case Schema.Notes.V1.tryTitle row.title of
  Nothing ->
    let previous = oldNote()
    previous.title
  Something title -> title
fn oldNote() -> Schema.Notes.V1.Note =
case Schema.Notes.V1.tryTitle "valid" of
  Nothing -> oldNote()
  Something title -> Schema.Notes.V1.Note { id: "fixture", title: title, memo: "base" }

fn noteWithTitle(value: String) -> Maybe Schema.Notes.V1.Note =
  case Schema.Notes.V1.tryTitle value of
    Nothing -> Nothing
    Something title -> Something (Schema.Notes.V1.Note { id: "fixture", title: title, memo: "base" })

test "stronger proof preserves a valid Unicode title" {
  case noteWithTitle "Äng 雪" of
    Nothing -> expect False
    Something old ->
      case convert old of
        Reject reason -> expect False
        Row current ->
          expect current.title == "Äng 雪"
          expect backward current == "Äng 雪"
}

test "a formerly valid title can fail the stronger proof" {
  case noteWithTitle "blocked" of
    Nothing -> expect False
    Something old ->
      case convert old of
        Reject reason -> expect reason == "title rejected by changed proof"
        Row current -> expect False
}

test "both schema validators reject an empty title" {
  case Schema.Notes.V1.tryTitle "" of
    Nothing -> expect True
    Something title -> expect False
  case Schema.Notes.VCurrent.tryTitle "" of
    Nothing -> expect True
    Something title -> expect False
}
