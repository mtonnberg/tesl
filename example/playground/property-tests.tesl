module PropertyTests exposing [clamp]

import Tesl.Prelude exposing [Int]

fn clamp(n: Int) -> Int =
  if n < 0 then
    0
  else
    if n > 10 then
      10
    else
      n

test "generated inputs stay in range" with 100 runs {
  property "within bounds" (n: Int) { clamp n >= 0 && clamp n <= 10 }
}

