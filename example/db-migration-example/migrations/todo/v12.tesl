module Schema.Todo.Migrate.V12 exposing [migration]
import Tesl.Migration exposing [Migration, Entity(..), Rule(..), Same(..), Migrated(..)]
import Tesl.Maybe exposing [Maybe(..)]
import Tesl.Prelude exposing [Bool(..)]
import Schema.Todo.V11
import Schema.Todo.V12

migration = Migration {
  from: Schema.Todo.V11
  to: Schema.Todo.V12
  same: [Same Schema.Todo.V11.ValidTitle Schema.Todo.V12.ValidTitle]
  fixtures: [previousTodo]
  entities: { Todo: Migrate addPriorityInfo [] }
}

# Store a real record payload derived from the retained row, with provenance.
fn addPriorityInfo(old: Schema.Todo.V11.Todo) -> Migrated Schema.Todo.V12.Todo =
  Row (Schema.Todo.V12.Todo {
    id: old.id
    title: old.title
    completed: old.completed
    details: old.details
    dueAt: old.dueAt
    projectId: old.projectId
    priorityWeight: old.priorityWeight
    priorityInfo: Schema.Todo.V12.PriorityInfo { weight: old.priorityWeight, origin: "migrated-v11" }
    reminderAt: old.reminderAt
  })

fn previousTodo() -> Maybe Schema.Todo.V11.Todo =
  case Schema.Todo.V11.tryTitle "Populate stored metadata" of
    Nothing -> Nothing
    Something title -> Something (Schema.Todo.V11.Todo {
      id: "record-priority"
      title: title
      completed: False
      details: Nothing
      dueAt: Nothing
      projectId: Nothing
      priorityWeight: 4
      reminderAt: Nothing
    })

test "existing weight becomes a nonempty record with provenance" {
  case previousTodo() of
    Nothing -> expect False
    Something old ->
      case addPriorityInfo old of
        Reject reason -> expect False
        Row current ->
          expect current.priorityInfo.weight == 4
          expect current.priorityInfo.origin == "migrated-v11"
          expect current.priorityWeight == old.priorityWeight
          expect current.title == old.title
          expect current.id == old.id
}

test "unchanged app constructor creates a nonempty record" {
  case Schema.Todo.V12.tryTitle "New weighted work" of
    Nothing -> expect False
    Something title ->
      let current = Schema.Todo.V12.newTodo "new-record" title
      expect current.priorityInfo.weight == 1
      expect current.priorityInfo.origin == "created"
      expect current.priorityWeight == 1
}
