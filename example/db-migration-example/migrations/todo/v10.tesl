module Schema.Todo.Migrate.V10 exposing [migration]
import Tesl.Migration exposing [Migration, Entity(..), Rule(..), Same(..), Migrated(..)]
import Tesl.Maybe exposing [Maybe(..)]
import Tesl.Prelude exposing [Bool(..)]
import Schema.Todo.V9
import Schema.Todo.V10

migration = Migration {
  from: Schema.Todo.V9
  to: Schema.Todo.V10
  same: [Same Schema.Todo.V9.ValidTitle Schema.Todo.V10.ValidTitle]
  fixtures: [previousTodo]
  entities: { Todo: Migrate migrateTodo [] }
}

# This storage value depends on the retained row, not a constant SQL default.
# Public request handlers never edit priority, so their API stays unchanged.
fn migrateTodo(old: Schema.Todo.V9.Todo) -> Migrated Schema.Todo.V10.Todo =
  Row (Schema.Todo.V10.Todo {
    id: old.id
    title: old.title
    completed: old.completed
    details: old.details
    dueAt: old.dueAt
    projectId: old.projectId
    priority: old.priority
    priorityWeight: old.priority + 1
    reminderAt: old.reminderAt
  })

# Use the real frozen schema's proof-producing constructor. No fact is asserted
# in the migration. A failed fixture establishment must not become a stored row.
fn previousTodo() -> Maybe Schema.Todo.V9.Todo =
  case Schema.Todo.V9.tryTitle "Keep a proven title" of
    Nothing -> Nothing
    Something title -> Something (Schema.Todo.V9.Todo {
      id: "weighted"
      title: title
      completed: False
      details: Nothing
      dueAt: Nothing
      projectId: Nothing
      priority: 4
      reminderAt: Nothing
    })

test "retained priority determines weight without losing the title proof" {
  case previousTodo() of
    Nothing -> expect False
    Something old ->
      case migrateTodo old of
        Reject reason -> expect False
        Row current ->
          expect current.priorityWeight == 5
          expect current.priority == 4
          expect current.title == old.title
          expect current.id == old.id
}
