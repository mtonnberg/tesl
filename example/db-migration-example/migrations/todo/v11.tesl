module Schema.Todo.Migrate.V11 exposing [migration]
import Tesl.Migration exposing [Migration, Entity(..), Rule(..), Same(..), Migrated(..)]
import Tesl.Maybe exposing [Maybe(..)]
import Tesl.Prelude exposing [Bool(..), Int]
import Schema.Todo.V10
import Schema.Todo.V11

migration = Migration {
  from: Schema.Todo.V10
  to: Schema.Todo.V11
  same: [Same Schema.Todo.V10.ValidTitle Schema.Todo.V11.ValidTitle]
  fixtures: [previousTodo]
  entities: { Todo: Migrate retirePriority [LegacyWith priority previousPriority] }
}

# Retain the weight introduced by V10; priority is no longer a current field.
fn retirePriority(old: Schema.Todo.V10.Todo) -> Migrated Schema.Todo.V11.Todo =
  Row (Schema.Todo.V11.Todo {
    id: old.id
    title: old.title
    completed: old.completed
    details: old.details
    dueAt: old.dueAt
    projectId: old.projectId
    priorityWeight: old.priorityWeight
    reminderAt: old.reminderAt
  })

# While V10 still serves, its old physical column must receive the compatible
# value. This rule is removed only by the checked Contract after retirement.
fn previousPriority(current: Schema.Todo.V11.Todo) -> Int =
  current.priorityWeight - 1

fn previousTodo() -> Maybe Schema.Todo.V10.Todo =
  case Schema.Todo.V10.tryTitle "Keep weighted work" of
    Nothing -> Nothing
    Something title -> Something (Schema.Todo.V10.Todo {
      id: "retire-priority"
      title: title
      completed: False
      details: Nothing
      dueAt: Nothing
      projectId: Nothing
      priority: 3
      priorityWeight: 4
      reminderAt: Nothing
    })

test "retiring priority preserves weight and reconstructs the old value" {
  case previousTodo() of
    Nothing -> expect False
    Something old ->
      case retirePriority old of
        Reject reason -> expect False
        Row current ->
          expect current.priorityWeight == 4
          expect previousPriority current == 3
          expect previousPriority current == old.priority
          expect current.title == old.title
          expect current.id == old.id
}
