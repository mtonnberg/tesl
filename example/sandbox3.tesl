import Sandbox exposing [dummy_add, ValidPort, IsPositive]

record S3Record {
  title: String
}

record S3Record2 {
  title: String
  foo3: Int
}

fn doSomething3(x: Int ::: ValidPort x) -> Int =
  dummy_add x x

fn doSomething2Of3(x: Int ::: ValidPort x && IsPositive x) -> Int =
  x
