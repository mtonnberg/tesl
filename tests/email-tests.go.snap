package teslmodemailtests

import "tesl.generated/teslmodemailtests/internal/teslrt"

//line email-tests.tesl:31
var AppEmailOutbox = teslrt.NewOutboxOn(TestDBDatabase, teslrt.SmtpSettings{
	Host:     teslrt.EnvString("SMTP_HOST", ""),
	Port:     587,
	Username: teslrt.EnvString("SMTP_USER", ""),
	Password: teslrt.EnvString("SMTP_PASS", ""),
	TLS:      true,
})

//line email-tests.tesl:42
var MarketingEmailOutbox = teslrt.NewOutboxOn(TestDBDatabase, teslrt.SmtpSettings{
	Host:     teslrt.EnvString("MKT_SMTP_HOST", ""),
	Port:     465,
	Username: teslrt.EnvString("MKT_SMTP_USER", ""),
	Password: teslrt.EnvString("MKT_SMTP_PASS", ""),
	TLS:      true,
})

//line email-tests.tesl:53
var NoTlsEmailOutbox = teslrt.NewOutboxOn(TestDBDatabase, teslrt.SmtpSettings{
	Host:     teslrt.EnvString("SMTP_HOST", ""),
	Port:     25,
	Username: teslrt.EnvString("SMTP_USER", ""),
	Password: teslrt.EnvString("SMTP_PASS", ""),
	TLS:      false,
})

//line email-tests.tesl:15
var TestDBDatabase = teslrt.NewDatabase(
	"TestDB",
	teslrt.PostgresConfig{DBName: "", User: "", Password: "", Host: "", Port: 5432, Schema: "public"},
	[]teslrt.PostgresTable{},
)

//line email-tests.tesl:66
func sendWelcome(addr string) struct{} {
//line email-tests.tesl:67
	return teslrt.SendEmail(AppEmailOutbox, addr, "Welcome!", teslrt.EmailBody{Tag: teslrt.EmailBodyRich, Text: "Hello!", HTML: "<h1>Hello!</h1>"})
}

//line email-tests.tesl:73
func sendSimple(addr string, subj string) struct{} {
//line email-tests.tesl:74
	return teslrt.SendEmail(AppEmailOutbox, addr, subj, teslrt.EmailBody{Tag: teslrt.EmailBodyText, Text: "Hello from Tesl"})
}

//line email-tests.tesl:80
func sendTextOnly(addr string, bodyText string) struct{} {
//line email-tests.tesl:81
	return teslrt.SendEmail(AppEmailOutbox, addr, "Notification", teslrt.EmailBody{Tag: teslrt.EmailBodyText, Text: bodyText})
}

//line email-tests.tesl:87
func sendHtmlOnly(addr string, html string) struct{} {
//line email-tests.tesl:88
	return teslrt.SendEmail(AppEmailOutbox, addr, "HTML Email", teslrt.EmailBody{Tag: teslrt.EmailBodyHTML, HTML: html})
}

//line email-tests.tesl:94
func sendMarketing(addr string) struct{} {
//line email-tests.tesl:95
	return teslrt.SendEmail(MarketingEmailOutbox, addr, "Special Offer", teslrt.EmailBody{Tag: teslrt.EmailBodyRich, Text: "Check out our deals", HTML: "<p>Check out our deals</p>"})
}

//line email-tests.tesl:101
func sendMultiple(a string, b string) struct{} {
	{
//line email-tests.tesl:102
		_ = teslrt.SendEmail(AppEmailOutbox, a, "First", teslrt.EmailBody{Tag: teslrt.EmailBodyText, Text: "Hello"})
//line email-tests.tesl:103
		return teslrt.SendEmail(AppEmailOutbox, b, "Second", teslrt.EmailBody{Tag: teslrt.EmailBodyText, Text: "Bye"})
	}
}

//line email-tests.tesl:105
func startEmailServices() struct{} {
//line email-tests.tesl:106
	return teslrt.StartEmailWorker(AppEmailOutbox)
}

//line email-tests.tesl:108
func startAllEmailServices() struct{} {
	{
//line email-tests.tesl:109
		_ = teslrt.SendEmail(AppEmailOutbox, "admin@example.com", "Starting", teslrt.EmailBody{Tag: teslrt.EmailBodyText, Text: "Services starting"})
//line email-tests.tesl:110
		return teslrt.StartEmailWorker(AppEmailOutbox)
	}
}

