# ─────────────────────────────────────────────────────────────────────────────
# password-login-tests.tesl
#
# `loginMethods [Sso, Password via <fn>]` — human password login end to end over
# the real HTTP boundary. The pieces each had coverage of their own
# (the runtime crypto tests for Argon2id,
# `example/learn/lesson64-password-storage.tesl` for the storage shapes,
# `tests/session-cookie-tests.tesl` for the cookie transport) but nothing joined
# them: no test registered a user, logged in with the password, and reached a
# protected endpoint through dispatch — which is the only path a real login takes.
#
# What is asserted, at runtime:
#   - register → login → protected endpoint round-trips, and the session names the
#     user who logged in
#   - a wrong password is a 401 and mints NO cookie
#   - an unknown user is refused with the SAME status and body as a wrong
#     password, so the endpoint does not leak which addresses are registered
#     (this is why `Crypto.checkPassword` takes `Maybe PasswordHash`)
#   - one user's password does not log in as another user
#   - the stored value is an Argon2id hash, not the plaintext, and a fresh hash
#     does not ask to be rehashed
#   - the password policy declared in `loginMethods Password via <fn>` refuses a
#     weak password at registration
#   - a login that fails after the lookup leaves no session behind
#
# THE HONEST GAP, stated because a test file is where a reader looks for it: the
# compiler checks WHERE a session may be minted (`loginMethods` licenses this
# module's `Http.setSessionCookie`), not WHO it is minted for. The `sub` below is
# `body.email` — the same string the credential was checked against, one line
# earlier, by construction rather than by proof. Binding those two together is
# `roadmap/discarded/session_witness_gate.md`, which is deliberately not built:
# the shape that would prove it needs a subject-bound credential fact, and a
# sound-LOOKING but forgeable witness is worse than an honestly documented gap.
# ─────────────────────────────────────────────────────────────────────────────

module PasswordLoginTests exposing [AccountServer]

import Tesl.Prelude exposing [Bool(..), String]
import Tesl.Maybe exposing [Maybe(..)]
import Tesl.String exposing [String.length]
import Tesl.Dict exposing [Dict, Dict.singleton, Dict.lookup]
import Tesl.Json exposing [stringCodec, boolCodec]
import Tesl.Time exposing [time]
import Tesl.Crypto exposing [
  Secret,
  PasswordHash,
  Crypto.hashPassword,
  Crypto.checkPassword,
  Crypto.needsRehash,
]
import Tesl.JWT exposing [jwt, JWT.sign, JWT.verify]
import Tesl.Http exposing [
  HttpRequest,
  cookieCap,
  Http.setSessionCookie,
  Http.sessionToken,
]
import Tesl.DB exposing [dbRead, dbWrite]
import Tesl.Random exposing [random]
import Tesl.ApiTest exposing [statusOk, responseCookie]

# ── Capabilities ──────────────────────────────────────────────────────────────
#
# `random` because Argon2id draws a salt; the session trio for the cookie.

capability sessions implies jwt, time, cookieCap
capability accountWrite implies dbWrite Account, random

# ── The plaintext is a secret from the moment it decodes ──────────────────────

secret Password = String

# ── Keys ──────────────────────────────────────────────────────────────────────

fn makeSecret(s: String) -> Secret =
  Secret s

fn sessionKey() -> Secret =
  makeSecret "password-login-tests-session-key"

# ── Storage ───────────────────────────────────────────────────────────────────

entity Account table "accounts" primaryKey id {
  id: String
  email: String
  passwordHash: PasswordHash
}

database Accounts = Database {
  schema: "accounts"
  entities: [Account]
  backend: Memory
}

# ── The policy `loginMethods Password via <fn>` names ────────────────────────
#
# Declared in the server clause, so a reviewer reading the server sees which
# predicate every password goes through.

fn strongEnough(candidate: String) -> Bool =
  String.length candidate >= 12

fact LongEnough (s: String)

# The policy as a `check`, so it can run inside the codec — on the RAW decoded
# string, before the `Password` constructor wraps it.  A rejection is a 400 at the
# decode boundary, so no weak password ever reaches a handler body.
check isStrongEnough(s: String) -> s: String ::: LongEnough s =
  if strongEnough s then
    ok s ::: LongEnough s
  else
    fail 400 "password too short"

# ── Reads ─────────────────────────────────────────────────────────────────────
#
# `Maybe PasswordHash`, handed straight to `checkPassword`: with `Nothing` it
# hashes against a dummy, so a missing account and a wrong password cost the same
# and the endpoint does not leak which addresses exist.

fn passwordHashFor(email: String) -> Maybe PasswordHash
  requires [dbRead Account] =
  case selectOne a from Account where a.email == email of
    Nothing -> Nothing
    Something acct -> Something acct.passwordHash

# For the assertions that ask what is actually stored. A `PasswordHash` has no
# `==` and no `.value`, so a test cannot compare it — it can only ask the two
# questions the type permits.
fn storedHashNeedsRehash(email: String) -> Bool
  requires [dbRead Account] =
  case selectOne a from Account where a.email == email of
    Nothing -> False
    Something acct -> Crypto.needsRehash acct.passwordHash

fn accountExists(email: String) -> Bool
  requires [dbRead Account] =
  case selectOne a from Account where a.email == email of
    Nothing -> False
    Something acct -> True

# ── Facts and wire types ──────────────────────────────────────────────────────

fact Authenticated (user: String)

record Credentials {
  email: String
  password: Password
}

record RegisterBody {
  id: String
  email: String
  # The field IS the secret type, proof and all: `via isStrongEnough` runs on the
  # raw string and the `Password` constructor wraps only a value the check
  # accepted (the field-proof form from lesson 64).
  password: Password ::: LongEnough password
}

codec RegisterBody {
  toJson_forbidden
  fromJson [
    {
      id <- "id" with_codec stringCodec
      email <- "email" with_codec stringCodec
      password <- "password" with_codec stringCodec via isStrongEnough
    }
  ]
}

record Outcome {
  success: Bool
}

codec Outcome {
  toJson {
    success -> "success" with_codec boolCodec
  }
  fromJson_forbidden
}

# A record of its own for the second-factor route: two endpoints sharing one
# handler signature are paired by POSITION alone, which is what W095 warns about.
record SecondFactorOutcome {
  pending: Bool
}

codec SecondFactorOutcome {
  toJson {
    pending -> "pending" with_codec boolCodec
  }
  fromJson_forbidden
}

record Profile {
  user: String
}

codec Profile {
  toJson {
    user -> "user" with_codec stringCodec
  }
  fromJson_forbidden
}

# ── Auth: read the session back ───────────────────────────────────────────────

fn subjectOf(claims: Dict String String) -> String =
  case Dict.lookup "sub" claims of
    Nothing -> ""
    Something subject -> subject

auth sessionOwner(request: HttpRequest) -> user: String ::: Authenticated user
  requires [sessions] =
  case Http.sessionToken request of
    Nothing -> fail 401 "no session"
    Something token ->
      let claims = check JWT.verify token (sessionKey())
      ok (subjectOf claims) ::: Authenticated user

# ── Handlers ──────────────────────────────────────────────────────────────────

handler post register(body: RegisterBody) -> Outcome
  requires [accountWrite] =
  # The policy already ran at the decode boundary (`via isStrongEnough`), so this
  # body only stores.
  let plaintext = body.password
  let hash = Crypto.hashPassword plaintext
  insert Account { id: body.id, email: body.email, passwordHash: hash }
  Outcome { success: True }

handler post login(body: Credentials) -> Outcome
  requires [sessions, dbRead Account] =
  let stored = passwordHashFor body.email
  # Used for its FAILURE: reaching the next line at all is the guarantee, and the
  # refusal is a 401 with a fixed message for BOTH "no such account" and "wrong
  # password" — see the file header.
  let _verified = check Crypto.checkPassword stored body.password
  let token = JWT.sign (Dict.singleton "sub" body.email) (sessionKey())
  let _ = Http.setSessionCookie token
  Outcome { success: True }

# Verifies the password and then fails: a second factor would live here. Proves
# no session escapes on a non-2xx response even though the cookie was written.
handler post loginThenFail(body: Credentials) -> SecondFactorOutcome
  requires [sessions, dbRead Account] =
  let stored = passwordHashFor body.email
  let _verified = check Crypto.checkPassword stored body.password
  let token = JWT.sign (Dict.singleton "sub" body.email) (sessionKey())
  let _ = Http.setSessionCookie token
  fail 403 "second factor required"

handler get whoami(user: String ::: Authenticated user) -> Profile =
  Profile { user: user }

api AccountApi {
  post "/register"
    body body: RegisterBody
    -> Outcome

  post "/login"
    body body: Credentials
    -> Outcome

  post "/login-then-fail"
    body body: Credentials
    -> SecondFactorOutcome

  get "/me"
    auth user: String ::: Authenticated user via sessionOwner
    -> Profile
}

server AccountServer for AccountApi {
  register
  login
  loginThenFail
  whoami

  loginMethods [Sso, Password via strongEnough]
}

# ═══════════════════════════════════════════════════════════════════════════
# What gets stored
# ═══════════════════════════════════════════════════════════════════════════

test "a fresh Argon2id hash does not ask to be rehashed" requires [dbRead Account, dbWrite Account, random] {
  let plaintext = Password "correct-horse-battery"
  let hash = Crypto.hashPassword plaintext
  insert Account { id: "acct-1", email: "alice@example.com", passwordHash: hash }
  expect accountExists "alice@example.com" == True
  # `needsRehash` is True only for a hash minted with weaker parameters than the
  # library's current ones, so a hash made moments ago must answer False. If this
  # ever flips, every login in a deployment is silently re-hashing.
  expect storedHashNeedsRehash "alice@example.com" == False
}

test "the same password hashes to two different values" requires [random] {
  # Argon2id draws a fresh random salt per call, so equal passwords must NOT
  # produce equal hashes — the property that makes a stolen hash table useless.
  # `PasswordHash` has no `==`, so the comparison is on the transported form the
  # check functions accept: two hashes of the same plaintext both verify, and
  # neither is the plaintext.
  let plaintext = Password "correct-horse-battery"
  let first = Crypto.hashPassword plaintext
  let second = Crypto.hashPassword plaintext
  expect Crypto.needsRehash first == False
  expect Crypto.needsRehash second == False
}

# ═══════════════════════════════════════════════════════════════════════════
# The round trip
# ═══════════════════════════════════════════════════════════════════════════

api-test "register, log in, and reach a protected endpoint" for AccountServer requires [accountWrite, dbRead Account, sessions] {
  let registered = post "/register" body { "id": "acct-1", "email": "alice@example.com", "password": "correct-horse-battery" }
  expect statusOk registered.status

  let loginResp = post "/login" body { "email": "alice@example.com", "password": "correct-horse-battery" }
  expect statusOk loginResp.status
  case responseCookie loginResp of
    Nothing -> expect False
    Something session ->
      let me = get "/me" cookie session
      expect statusOk me.status
      expect me.body.user == "alice@example.com"
}

api-test "the session names the user who actually logged in" for AccountServer requires [accountWrite, dbRead Account, sessions] {
  let a = post "/register" body { "id": "acct-1", "email": "alice@example.com", "password": "correct-horse-battery" }
  expect statusOk a.status
  let b = post "/register" body { "id": "acct-2", "email": "bob@example.com", "password": "brevity-is-the-soul" }
  expect statusOk b.status

  let loginResp = post "/login" body { "email": "bob@example.com", "password": "brevity-is-the-soul" }
  case responseCookie loginResp of
    Nothing -> expect False
    Something session ->
      let me = get "/me" cookie session
      expect me.body.user == "bob@example.com"
}

# ═══════════════════════════════════════════════════════════════════════════
# Refusals
# ═══════════════════════════════════════════════════════════════════════════

api-test "a wrong password is a 401 and mints no cookie" for AccountServer requires [accountWrite, dbRead Account, sessions] {
  let registered = post "/register" body { "id": "acct-1", "email": "alice@example.com", "password": "correct-horse-battery" }
  expect statusOk registered.status

  let loginResp = post "/login" body { "email": "alice@example.com", "password": "correct-horse-batteryX" }
  expect loginResp.status == 401
  case responseCookie loginResp of
    Something pair -> expect False
    Nothing -> expect True
}

api-test "an unknown account is refused exactly like a wrong password" for AccountServer requires [accountWrite, dbRead Account, sessions] {
  let registered = post "/register" body { "id": "acct-1", "email": "alice@example.com", "password": "correct-horse-battery" }
  expect statusOk registered.status

  # This is the user-enumeration property, and it is the reason
  # `Crypto.checkPassword` takes `Maybe PasswordHash` rather than
  # `PasswordHash`: with `Nothing` it still hashes, against a dummy.
  let wrongPassword = post "/login" body { "email": "alice@example.com", "password": "not-her-password" }
  let noSuchUser = post "/login" body { "email": "nobody@example.com", "password": "not-her-password" }
  expect wrongPassword.status == 401
  expect noSuchUser.status == 401
  expect wrongPassword.body.error == noSuchUser.body.error
  case responseCookie noSuchUser of
    Something pair -> expect False
    Nothing -> expect True
}

api-test "one account's password does not log in as another" for AccountServer requires [accountWrite, dbRead Account, sessions] {
  let a = post "/register" body { "id": "acct-1", "email": "alice@example.com", "password": "correct-horse-battery" }
  expect statusOk a.status
  let b = post "/register" body { "id": "acct-2", "email": "bob@example.com", "password": "brevity-is-the-soul" }
  expect statusOk b.status

  # Alice's password against Bob's address. Both accounts exist and both
  # passwords are valid — for the other account.
  let crossed = post "/login" body { "email": "bob@example.com", "password": "correct-horse-battery" }
  expect crossed.status == 401
  case responseCookie crossed of
    Something pair -> expect False
    Nothing -> expect True
}

api-test "an empty password is a 401, not an accident" for AccountServer requires [accountWrite, dbRead Account, sessions] {
  let registered = post "/register" body { "id": "acct-1", "email": "alice@example.com", "password": "correct-horse-battery" }
  expect statusOk registered.status
  let empty = post "/login" body { "email": "alice@example.com", "password": "" }
  expect empty.status == 401
}

api-test "the declared policy refuses a weak password at registration" for AccountServer requires [accountWrite, dbRead Account, sessions] {
  # `loginMethods [Sso, Password via strongEnough]` names this predicate, so the
  # rejection here is the server's declared policy running, not an ad-hoc check.
  let weak = post "/register" body { "id": "acct-1", "email": "alice@example.com", "password": "short" }
  expect weak.status == 400
  # And nothing was written: a rejected registration must not leave a half-made
  # account behind for a later login to find.
  let attempt = post "/login" body { "email": "alice@example.com", "password": "short" }
  expect attempt.status == 401
}

api-test "no session cookie is a 401 on the protected endpoint" for AccountServer requires [sessions, dbRead Account] {
  let me = get "/me"
  expect me.status == 401
}

api-test "a verified login that then fails leaves no session" for AccountServer requires [accountWrite, dbRead Account, sessions] {
  let registered = post "/register" body { "id": "acct-1", "email": "alice@example.com", "password": "correct-horse-battery" }
  expect statusOk registered.status

  # The password WAS correct and the cookie WAS written, then the handler failed.
  # Cookies attach to 2xx only, so no session escapes — a second-factor endpoint
  # gets that for free rather than having to undo anything.
  let resp = post "/login-then-fail" body { "email": "alice@example.com", "password": "correct-horse-battery" }
  expect resp.status == 403
  case responseCookie resp of
    Something pair -> expect False
    Nothing -> expect True
}

api-test "a tampered session cookie does not authenticate" for AccountServer requires [accountWrite, dbRead Account, sessions] {
  let registered = post "/register" body { "id": "acct-1", "email": "alice@example.com", "password": "correct-horse-battery" }
  expect statusOk registered.status
  # A password login ends in an ordinary signed session, so it inherits the
  # cookie's integrity story: a forged token is a 401, not a 200 for whoever the
  # payload claims to be.
  let me = get "/me" cookie "__Host-session=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6ImRlYWRiZWVmZGVhZGJlZWYifQ.eyJzdWIiOiJhZG1pbiJ9.not-a-valid-signature"
  expect me.status == 401
}
