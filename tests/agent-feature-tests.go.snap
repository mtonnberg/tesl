func TestTesl39(teslT *testing.T) {
	if teslWanted := os.Getenv("TESL_TEST_NAME"); teslWanted != "" && teslWanted != "converse threads turn 1 history into turn 2" && teslWanted != "TestTesl39" {
		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	{
//line agent-feature-tests.tesl:503
		agent := teslrt.Agent{Provider: teslrt.MockProvider([]string{"First reply about cats", "Second reply still about cats"}), SystemPrompt: "bot.", MaxTokens: teslrt.FromInt64(128), Tools: []teslrt.Tool{}}
		_ = agent
		{
//line agent-feature-tests.tesl:504
			conv0 := teslrt.NewConversation(agent)
			_ = conv0
			{
//line agent-feature-tests.tesl:505
				turn1 := teslrt.Converse(conv0, "Tell me about cats")
				_ = turn1
				{
//line agent-feature-tests.tesl:506
					conv1 := teslrt.TurnConversation(turn1)
					_ = conv1
					teslLeft59 := teslrt.ReplyText(teslrt.TurnReply(turn1))
//line agent-feature-tests.tesl:507
					if teslLeft59 != "First reply about cats" {
						teslT.Fatal("Tesl expectation failed")
					}
					teslLeft60 := teslrt.ConversationLength(conv1)
//line agent-feature-tests.tesl:508
					if !teslrt.Equal(teslLeft60, teslrt.FromInt64(2)) {
						teslT.Fatal("Tesl expectation failed")
					}
					{
//line agent-feature-tests.tesl:509
						turn2 := teslrt.Converse(conv1, "What did I just ask about?")
						_ = turn2
						{
//line agent-feature-tests.tesl:510
							conv2 := teslrt.TurnConversation(turn2)
							_ = conv2
							teslLeft61 := teslrt.ReplyText(teslrt.TurnReply(turn2))
//line agent-feature-tests.tesl:511
							if teslLeft61 != "Second reply still about cats" {
								teslT.Fatal("Tesl expectation failed")
							}
							teslLeft62 := teslrt.ConversationLength(conv2)
//line agent-feature-tests.tesl:512
							if !teslrt.Equal(teslLeft62, teslrt.FromInt64(4)) {
								teslT.Fatal("Tesl expectation failed")
							}
							{
//line agent-feature-tests.tesl:513
								history := teslrt.ConversationJSON(conv2)
								_ = history
//line agent-feature-tests.tesl:514
								if !(teslrt.StringContains(history, "Tell me about cats")) {
									teslT.Fatal("Tesl expectation failed")
								}
//line agent-feature-tests.tesl:515
								if !(teslrt.StringContains(history, "First reply about cats")) {
									teslT.Fatal("Tesl expectation failed")
								}
//line agent-feature-tests.tesl:516
								if !(teslrt.StringContains(history, "What did I just ask about?")) {
									teslT.Fatal("Tesl expectation failed")
								}
							}
						}
					}
				}
			}
		}
	}
}

