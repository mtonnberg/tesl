		_ = weatherTool
		{
//line agent-feature-tests.tesl:390
			bad := teslrt.ToolUseStep("get_weather", "c1", "{\"nope\":1}")
			_ = bad
			{
//line agent-feature-tests.tesl:391
				good := teslrt.ToolUseStep("get_weather", "c2", "{\"city\":\"Lund\"}")
				_ = good
				{
//line agent-feature-tests.tesl:392
					final := teslrt.TextStep("Looked up Lund.")
					_ = final
					{
//line agent-feature-tests.tesl:393
						agent := teslrt.Agent{Provider: teslrt.MockToolProvider([]teslrt.LlmResponse{bad, good, final}), SystemPrompt: "x", MaxTokens: teslrt.FromInt64(256), Tools: []teslrt.Tool{weatherTool}}
