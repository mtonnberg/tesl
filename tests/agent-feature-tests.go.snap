					_ = s
					teslLeft84 := s.Label
//line agent-feature-tests.tesl:683
					if teslLeft84 != "happy" {
						teslT.Fatal("Tesl expectation failed")
					}
				}
			}
		}
	}
}

func TestTesl59(teslT *testing.T) {
	if teslWanted := os.Getenv("TESL_TEST_NAME"); teslWanted != "" && teslWanted != "a listed tool the model never calls leaves the reply unchanged" && teslWanted != "TestTesl59" {
		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	{
//line agent-feature-tests.tesl:687
		weatherTool := teslrt.ToolOf("get_weather", "weather", "{}", validateWeather, dispatchWeather)
		_ = weatherTool
		{
//line agent-feature-tests.tesl:688
			agent := teslrt.Agent{Provider: teslrt.MockToolProvider([]teslrt.LlmResponse{teslrt.TextStep("no call")}), SystemPrompt: "x", MaxTokens: teslrt.FromInt64(64), Tools: []teslrt.Tool{weatherTool}}
			_ = agent
			teslLeft85 := teslrt.ReplyText(teslrt.AskReply(agent, "hi"))
//line agent-feature-tests.tesl:689
			if teslLeft85 != "no call" {
				teslT.Fatal("Tesl expectation failed")
			}
		}
	}
}
