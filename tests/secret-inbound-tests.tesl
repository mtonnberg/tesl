module SecretInbound exposing [
  Password,
  LoginBody,
  LoginOut,
  login,
  InboundApi,
  InboundServer,
]

# `secret X = T`, the INBOUND half (roadmap/next/tesl_crypto.md Phase 4).
#
# The plaintext password in a request body is the highest-value secret in the
# system, and before this feature it had no protection at all — it was a
# `String`, interpolatable into a log line, renderable in a debugger, and
# serializable straight back out in a response.  Declaring the field `Password`
# fixes all four, and the ONE thing that has to keep working for that to be
# adoptable is the thing this file proves end to end: a secret still DECODES
# from JSON.
#
# What is being verified, concretely:
#
#   * `record LoginBody { email: String, password: Password }` is accepted in a
#     REQUEST position (a response position with the same type is a compile
#     error — see compiler/test/test_secret_surface.ml).
#   * The decoder MINTS the newtype from a bare JSON string, so the handler
#     receives a `Password`, not a `String`.
#   * `==` on two secrets still answers correctly — and now lowers to a
#     constant-time compare (tests/secret-runtime-tests.rkt pins the timing
#     shape; here we only pin that it still says yes to equal and no to
#     different, because a "safe" comparison that always answers #f would
#     silently break every login in the world).
#
# The test asserts on BEHAVIOUR, not on the value — asserting on the value is
# impossible, correctly.  That is the one real cost of the feature, and it is
# stated rather than softened.

import Tesl.Prelude exposing [Bool, String]
import Tesl.ApiTest exposing [statusOk]

secret Password = String

record LoginBody { email: String, password: Password }
record LoginOut { matched: Bool }

handler login(body: LoginBody) -> LoginOut =
  let expected = Password "hunter2"
  let out = LoginOut { matched: body.password == expected }
  out

api InboundApi {
  post "/login"
    body body: LoginBody
    -> LoginOut
}

server InboundServer for InboundApi {
  login = login
}

api-test "a secret decodes from a JSON request body and compares constant-time" for InboundServer {
  let good = post "/login" body { "email": "ab", "password": "hunter2" }
  expect statusOk good.status
  expect good.body.matched == True

  let nope = post "/login" body { "email": "ab", "password": "wrong" }
  expect statusOk nope.status
  expect nope.body.matched == False
}
