		k := teslrt.PropInt()
		_ = k
		if (teslrt.Compare(k, teslrt.Sub(teslrt.FromInt64(0), teslrt.FromInt64(5000))) > 0) && (teslrt.Compare(k, teslrt.FromInt64(5000)) < 0) {
			if !(addDiffInverse(k)) {
				teslT.Fatalf("property \"diffDays (addDays d k) d == k\" failed (k=%v)", k)
			}
		}
	}
}

func TestTesl21(teslT *testing.T) {
	if teslWanted := os.Getenv("TESL_TEST_NAME"); teslWanted != "" && teslWanted != "a civil day in a DST zone is 23 h or 25 h, and the bridge knows it" && teslWanted != "TestTesl21" {
		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	teslLeft83 := dayLengthSeconds(stockholmDay(teslrt.FromInt64(2026), teslmodciviltime.Month{Tag: teslmodciviltime.MonthMarch}, teslrt.FromInt64(29)))
	teslRight83 := teslrt.Mul(teslrt.FromInt64(23), teslrt.FromInt64(3600))
//line civil-time-tests.tesl:300
	if !teslrt.Equal(teslLeft83, teslRight83) {
		teslT.Fatal("Tesl expectation failed")
	}
	teslLeft84 := dayLengthSeconds(stockholmDay(teslrt.FromInt64(2026), teslmodciviltime.Month{Tag: teslmodciviltime.MonthOctober}, teslrt.FromInt64(25)))
	teslRight84 := teslrt.Mul(teslrt.FromInt64(25), teslrt.FromInt64(3600))
//line civil-time-tests.tesl:301
	if !teslrt.Equal(teslLeft84, teslRight84) {
		teslT.Fatal("Tesl expectation failed")
	}
	teslLeft85 := dayLengthSeconds(stockholmDay(teslrt.FromInt64(2026), teslmodciviltime.Month{Tag: teslmodciviltime.MonthAugust}, teslrt.FromInt64(5)))
	teslRight85 := teslrt.Mul(teslrt.FromInt64(24), teslrt.FromInt64(3600))
//line civil-time-tests.tesl:302
	if !teslrt.Equal(teslLeft85, teslRight85) {
		teslT.Fatal("Tesl expectation failed")
	}
}

func TestTesl22(teslT *testing.T) {
	if teslWanted := os.Getenv("TESL_TEST_NAME"); teslWanted != "" && teslWanted != "startOfDay is local midnight, and agrees with Time.truncDay" && teslWanted != "TestTesl22" {
		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	{
//line civil-time-tests.tesl:309
		noonAfterSpringForward := teslrt.AddMs(teslmodciviltime.StartOfDay(stockholmDay(teslrt.FromInt64(2026), teslmodciviltime.Month{Tag: teslmodciviltime.MonthMarch}, teslrt.FromInt64(29))), teslrt.Mul(teslrt.FromInt64(14), teslrt.FromInt64(3600000)))
		_ = noonAfterSpringForward
		{
//line civil-time-tests.tesl:310
			d := teslmodciviltime.FromInstant(teslrt.NamedZone("Europe/Stockholm"), noonAfterSpringForward)
			_ = d
			teslLeft86 := teslmodciviltime.ToIso(d)
//line civil-time-tests.tesl:311
			if teslLeft86 != "2026-03-29" {
				teslT.Fatal("Tesl expectation failed")
			}
			teslLeft87 := teslrt.PosixToSeconds(teslmodciviltime.StartOfDay(d))
			teslRight87 := teslrt.PosixToSeconds(teslrt.TimeTruncDay(teslrt.NamedZone("Europe/Stockholm"), noonAfterSpringForward))
//line civil-time-tests.tesl:312
			if !teslrt.Equal(teslLeft87, teslRight87) {
				teslT.Fatal("Tesl expectation failed")
			}
			teslLeft88 := teslrt.TimeOffsetAt(teslrt.NamedZone("Europe/Stockholm"), teslmodciviltime.StartOfDay(d))
//line civil-time-tests.tesl:313
			if !teslrt.Equal(teslLeft88, teslrt.FromInt64(60)) {
				teslT.Fatal("Tesl expectation failed")
			}
			teslLeft89 := teslrt.TimeOffsetAt(teslrt.NamedZone("Europe/Stockholm"), teslmodciviltime.EndOfDay(d))
//line civil-time-tests.tesl:314
			if !teslrt.Equal(teslLeft89, teslrt.FromInt64(120)) {
				teslT.Fatal("Tesl expectation failed")
			}
		}
	}
}

func TestTesl23(teslT *testing.T) {
	if teslWanted := os.Getenv("TESL_TEST_NAME"); teslWanted != "" && teslWanted != "millisecond day arithmetic is wrong exactly where addDays is right" && teslWanted != "TestTesl23" {
		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	{
//line civil-time-tests.tesl:321
		start := teslmodciviltime.StartOfDay(stockholmDay(teslrt.FromInt64(2026), teslmodciviltime.Month{Tag: teslmodciviltime.MonthMarch}, teslrt.FromInt64(29)))
		_ = start
		{
//line civil-time-tests.tesl:322
			msNextDay := teslrt.AddMs(start, teslrt.FromInt64(86400000))
			_ = msNextDay
			{
//line civil-time-tests.tesl:323
				civilNextDay := teslmodciviltime.StartOfDay(teslmodciviltime.AddDays(stockholmDay(teslrt.FromInt64(2026), teslmodciviltime.Month{Tag: teslmodciviltime.MonthMarch}, teslrt.FromInt64(29)), teslrt.FromInt64(1)))
				_ = civilNextDay
				teslLeft90 := teslrt.Sub(teslrt.PosixToSeconds(msNextDay), teslrt.PosixToSeconds(civilNextDay))
//line civil-time-tests.tesl:324
				if !teslrt.Equal(teslLeft90, teslrt.FromInt64(3600)) {
					teslT.Fatal("Tesl expectation failed")
				}
				teslLeft91 := teslmodciviltime.ToIso(teslmodciviltime.FromInstant(teslrt.NamedZone("Europe/Stockholm"), civilNextDay))
//line civil-time-tests.tesl:325
				if teslLeft91 != "2026-03-30" {
					teslT.Fatal("Tesl expectation failed")
				}
			}
		}
	}
}

func TestTesl24(teslT *testing.T) {
	if teslWanted := os.Getenv("TESL_TEST_NAME"); teslWanted != "" && teslWanted != "two dates in different zones cannot be diffed" && teslWanted != "TestTesl24" {
