	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	{
//line civil-time-tests.tesl:338
		inUtc := teslmodciviltime.FromDayNumber(teslrt.UtcZone(), teslrt.FromInt64(20000))
		_ = inUtc
		{
//line civil-time-tests.tesl:339
			inStockholm := teslmodciviltime.FromDayNumber(teslrt.NamedZone("Europe/Stockholm"), teslrt.FromInt64(20000))
			_ = inStockholm
			teslLeft92 := teslmodciviltime.DayNumber(inUtc)
			teslRight92 := teslmodciviltime.DayNumber(inStockholm)
//line civil-time-tests.tesl:340
			if !teslrt.Equal(teslLeft92, teslRight92) {
				teslT.Fatal("Tesl expectation failed")
			}
//line civil-time-tests.tesl:341
			teslExpectFailure(teslT, func() {
				_ = diffAcrossZones()
			})
		}
	}
}
