	return teslrt.Sub(teslrt.PosixToSeconds(teslmodciviltime.EndOfDay(d)), teslrt.PosixToSeconds(teslmodciviltime.StartOfDay(d)))
}

//line civil-time-tests.tesl:331
func diffAcrossZones() teslrt.Int {
	{
//line civil-time-tests.tesl:332
		inUtc := teslmodciviltime.FromDayNumber(teslrt.UtcZone(), teslrt.FromInt64(20000))
		_ = inUtc
		{
//line civil-time-tests.tesl:333
			inStockholm := teslmodciviltime.FromDayNumber(teslrt.NamedZone("Europe/Stockholm"), teslrt.FromInt64(20000))
			_ = inStockholm
			{
//line civil-time-tests.tesl:334
				bad := teslrt.MustCheck(teslmodciviltime.SameCalendar(inUtc, inStockholm))
				_ = bad
//line civil-time-tests.tesl:335
				return teslmodciviltime.DiffDays(inUtc, bad)
			}
		}
	}
}

