func TestTesl25(teslT *testing.T) {
	if teslWanted := os.Getenv("TESL_TEST_NAME"); teslWanted != "" && teslWanted != "ExchangeRate accessors round-trip the construction arguments" && teslWanted != "TestTesl25" {
		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	{
//line money-tests.tesl:283
		r := teslrt.ExchangeRateMake(teslrt.CurrencyOf("USD", 2), teslrt.CurrencyOf("EUR", 2), float64(0.9155), teslrt.SecondsToPosix(teslrt.FromInt64(42)))
		_ = r
		teslLeft51 := teslrt.ExchangeRateRate(r)
//line money-tests.tesl:286
		if !teslrt.FloatEqual(teslLeft51, float64(0.9155)) {
			teslT.Fatal("Tesl expectation failed")
		}
		teslLeft52 := teslrt.CurrencyCode(teslrt.ExchangeRateFromCurrency(r))
//line money-tests.tesl:287
		if teslLeft52 != "USD" {
			teslT.Fatal("Tesl expectation failed")
		}
		teslLeft53 := teslrt.CurrencyCode(teslrt.ExchangeRateToCurrency(r))
//line money-tests.tesl:288
		if teslLeft53 != "EUR" {
			teslT.Fatal("Tesl expectation failed")
		}
		teslLeft54 := teslrt.PosixToSeconds(teslrt.ExchangeRateAsOf(r))
//line money-tests.tesl:289
		if !teslrt.Equal(teslLeft54, teslrt.FromInt64(42)) {
			teslT.Fatal("Tesl expectation failed")
		}
	}
}

func TestTesl26(teslT *testing.T) {
	if teslWanted := os.Getenv("TESL_TEST_NAME"); teslWanted != "" && teslWanted != "abs is identity on non-negatives; zero is never negative" && teslWanted != "TestTesl26" {
		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	teslLeft55 := teslrt.MoneyMinorUnits(teslrt.MoneyAbs(teslrt.MoneyOf(teslrt.FromInt64(750), "USD", 2)))
//line money-tests.tesl:295
	if !teslrt.Equal(teslLeft55, teslrt.FromInt64(750)) {
		teslT.Fatal("Tesl expectation failed")
	}
//line money-tests.tesl:296
	if !(teslrt.MoneyIsZero(teslrt.MoneyNegate(teslrt.MoneyOf(teslrt.FromInt64(0), "USD", 2)))) {
		teslT.Fatal("Tesl expectation failed")
	}
//line money-tests.tesl:297
	if teslrt.MoneyIsNegative(teslrt.MoneyOf(teslrt.FromInt64(0), "USD", 2)) {
		teslT.Fatal("Tesl expectation failed")
	}
//line money-tests.tesl:298
	if teslrt.MoneyIsNegative(teslrt.MoneyNegate(teslrt.MoneyOf(teslrt.FromInt64(0), "USD", 2))) {
		teslT.Fatal("Tesl expectation failed")
	}
}

