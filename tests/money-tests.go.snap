	teslLeft31 := convertError(usdToEur(float64(0.5)), teslrt.MoneyOf(teslrt.FromInt64(100), "SEK", 2))
//line money-tests.tesl:214
	if teslLeft31 != "exchange rate is FROM USD but amount is in SEK" {
		teslT.Fatal("Tesl expectation failed")
	}
	teslLeft32 := convertedMinor(usdToEur(float64(0.5)), teslrt.MoneyOf(teslrt.FromInt64(100), "SEK", 2))
	teslRight32 := teslrt.Sub(teslrt.FromInt64(0), teslrt.FromInt64(1))
//line money-tests.tesl:215
	if !teslrt.Equal(teslLeft32, teslRight32) {
		teslT.Fatal("Tesl expectation failed")
	}
}

