			case teslrt.MaybeNothing:
				teslLeft20 := false
				teslRight20 := true
//line sql-clause-placement-tests.tesl:207
				if teslLeft20 != teslRight20 {
//line sql-clause-placement-tests.tesl:207
					teslT.Fatal("Tesl expectation failed")
				}
			default:
				panic("unreachable: checker guarantees case exhaustiveness")
			}
		}
	}
}

func TestTesl7(teslT *testing.T) {
	if teslWanted := os.Getenv("TESL_TEST_NAME"); teslWanted != "" && teslWanted != "#77: property - spelling never changes the result" && teslWanted != "TestTesl7" {
		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	teslResetTestState()
	defer func() {
		if teslTrap := recover(); teslTrap != nil {
			teslT.Fatalf("Tesl test trapped: %v", teslTrap)
		}
	}()
	{
//line sql-clause-placement-tests.tesl:215
		_ = seed()
		for teslPropRun2 := 0; teslPropRun2 < 40; teslPropRun2++ {
//line sql-clause-placement-tests.tesl:216
			k := teslrt.PropInt()
			_ = k
			if (teslrt.Compare(k, teslrt.FromInt64(0)) > 0) && (teslrt.Compare(k, teslrt.FromInt64(12)) < 0) {
				if !teslrt.ListEqualBy(names(aboveOneLine("o1", k)), names(aboveMultiLine("o1", k)), teslEqualString) {
					teslT.Fatalf("property \"one-line == multi-line for any qty threshold\" failed (k=%v)", k)
				}
			}
		}
	}
}

