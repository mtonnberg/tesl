func TestTesl120(teslT *testing.T) {
	if teslWanted := os.Getenv("TESL_TEST_NAME"); teslWanted != "" && teslWanted != "T26c: append length is additive" && teslWanted != "TestTesl120" {
		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	defer func() {
		if teslTrap := recover(); teslTrap != nil {
			teslT.Fatalf("Tesl test trapped: %v", teslTrap)
		}
	}()
	for teslPropRun1 := 0; teslPropRun1 < 200; teslPropRun1++ {
//line critical-review-28-tests.tesl:1122
		xs := teslrt.PropList(func() teslrt.Int { return teslrt.PropInt() })
		_ = xs
		ys := teslrt.PropList(func() teslrt.Int { return teslrt.PropInt() })
