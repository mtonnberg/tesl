func TestTesl22(teslT *testing.T) {
	if teslWanted := os.Getenv("TESL_TEST_NAME"); teslWanted != "" && teslWanted != "Time.add and Time.diff speak typed Duration" && teslWanted != "TestTesl22" {
		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	{
//line units-tests.tesl:231
		ts := teslrt.SecondsToPosix(teslrt.FromInt64(1000))
		_ = ts
		{
//line units-tests.tesl:232
			later := teslrt.TimeAdd(ts, teslrt.DurationHours(float64(2)))
			_ = later
			teslLeft43 := teslrt.PosixToSeconds(later)
//line units-tests.tesl:233
			if !teslrt.Equal(teslLeft43, teslrt.FromInt64(8200)) {
				teslT.Fatal("Tesl expectation failed")
			}
			teslLeft44 := teslrt.DurationInSeconds(teslrt.TimeDiff(ts, later))
//line units-tests.tesl:234
			if !teslrt.FloatEqual(teslLeft44, float64(7.2e+03)) {
				teslT.Fatal("Tesl expectation failed")
			}
			teslLeft45 := teslrt.PosixToSeconds(teslrt.TimeSubtract(later, teslrt.DurationHours(float64(2))))
//line units-tests.tesl:235
			if !teslrt.Equal(teslLeft45, teslrt.FromInt64(1000)) {
				teslT.Fatal("Tesl expectation failed")
			}
		}
	}
}
