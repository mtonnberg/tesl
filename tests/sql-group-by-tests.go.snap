	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	teslResetTestState()
	{
//line sql-group-by-tests.tesl:192
		_ = seed()
		{
//line sql-group-by-tests.tesl:195
			days := minutesPerDay("acme", teslrt.NamedZone("Europe/Stockholm"))
			_ = days
			teslLeft27 := teslrt.ListLength(days)
//line sql-group-by-tests.tesl:196
			if !teslrt.Equal(teslLeft27, teslrt.FromInt64(3)) {
				teslT.Fatal("Tesl expectation failed")
			}
			teslLeft28 := firstValue(days)
//line sql-group-by-tests.tesl:197
			if !teslrt.Equal(teslLeft28, teslrt.FromInt64(60)) {
				teslT.Fatal("Tesl expectation failed")
			}
		}
	}
}

// teslResetTestState empties the stores every test block starts from, so no block
// inherits another's rows, jobs, or outbound-HTTP stubs.
func teslResetTestState() {
	teslrt.TableTruncate(EntryTable)
}
