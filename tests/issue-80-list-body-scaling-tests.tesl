module Issue80ListBodyScalingTests exposing [Issue80Server]

import Tesl.Prelude exposing [String, List]
import Tesl.Json exposing [stringCodec, listCodec]
import Tesl.List exposing [List.map]
import Tesl.ApiTest exposing [statusOk, statusClientError]

# ── Regression: GitHub #80 ───────────────────────────────────────────────────
# A request body carrying a `List String` field (decoded `with_codec listCodec`)
# got QUADRATICALLY slower in the list's length: every recursion level of the
# lifted `List.map` re-validated its whole returned suffix, and each of those
# per-element checks paid several full registry scans.  Under a 50rps load-test
# the queueing turned that into p50 876ms for a SIX-element list.
#
# This file pins the fix with the same shape the report used: a handler that
# does no database work at all — it only decodes the list body and maps a pure
# function over it — hammered with a TWO-HUNDRED-element list (the issue's
# documented batch cap).  Before the fix a single such request cost hundreds of
# milliseconds on its own, so the p99 bound below failed by an order of
# magnitude; after it, a request is single-digit milliseconds.
#
# The api-test guards the semantics the perf fix touched: the decoded list must
# still arrive intact, in order, and element-typed (a non-string element in the
# JSON array must still be rejected), so the fast path cannot silently become
# a no-validation path.

record RefsRequest {
  refs: List String
}

codec RefsRequest {
  toJson_forbidden
  fromJson [
    { refs <- "refs" with_codec listCodec }
  ]
}

record RefResult {
  text: String
}

codec RefResult {
  toJson {
    text -> "text" with_codec stringCodec
  }
  fromJson_forbidden
}

fn resolveOne(ref: String) -> RefResult =
  RefResult { text: ref }

handler post resolveRefs(body: RefsRequest) -> List RefResult =
  List.map resolveOne body.refs

api Issue80Api {
  post "/api/refs"
    body body: RefsRequest
    -> List RefResult
}

server Issue80Server for Issue80Api {
  resolveRefs
}

api-test "list body decodes intact, in order, and element-typed" for Issue80Server {
  let resp = post "/api/refs" body { "refs": ["alpha", "beta", "gamma"] }
  expect statusOk resp.status
  expect resp.body == [
    { "text": "alpha" },
    { "text": "beta" },
    { "text": "gamma" }
  ]

  let bad = post "/api/refs" body { "refs": ["alpha", 42] }
  expect statusClientError bad.status
}

load-test "200-element List String body stays linear (issue #80)" for Issue80Server
