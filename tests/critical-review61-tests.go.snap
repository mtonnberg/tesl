}

func (teslLeft Container) TeslEqual(teslRight Container) bool {
	if teslLeft.Tag != teslRight.Tag {
		return false
	}
	switch teslLeft.Tag {
	case ContainerFilled:
		return teslEqualContainerFilled(teslLeft, teslRight)
	case ContainerEmpty:
		return true
	default:
		return true
	}
}

func teslEqualContainerFilled(teslLeft, teslRight Container) bool {
