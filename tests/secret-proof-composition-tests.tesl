module SecretProofComposition exposing [
  Password,
  RegisterBody,
  RegisterOut,
  register,
  RegisterApi,
  RegisterServer,
]

# roadmap/next/secret_wrapped_credentials.md — does a validated proof compose
# with `secret X = T` yet?
#
# The gap the roadmap item asks about: `secret Password = String ::: LongEnough`
# is NOT expressible as a declaration — the newtype grammar's base is a plain
# `type_expr`, and a proof annotation only attaches to a param binding, return
# spec, or record FIELD (confirmed empirically: the declaration form is a
# parse error, "unexpected token at top level: :::"; the field form is not).
#
# The fix is not a grammar change: the field IS the secret type, proof and
# all (`password: Password ::: LongEnough password`) — record fields already
# carry proof annotations, and the inbound path already mints a secret
# straight from a bare JSON string, so this is those two shipped mechanisms
# composing. `isLongEnough` runs on the RAW decoded string during JSON
# decode — matching its own declared signature — and the `Password`
# constructor wraps only a value the check already accepted, so `body.password`
# is redacted (telemetry, logs, both debugger surfaces — proven generically
# for ANY `secret` newtype by the runtime secret tests) from the moment
# the handler sees it, with no manual wrap step.
#
# See tests/secret-inbound-tests.tesl for the sibling proof that a bare
# `secret` newtype decodes straight from JSON with no validation at all, and
# roadmap/completed/secret_wrapped_credentials.md for the compiler bug this
# composition surfaced (the newtype wrap used to run BEFORE the `via` check,
# handing the plaintext to an arbitrary check function unwrapped) and its fix.

import Tesl.Prelude exposing [Bool, String]
import Tesl.String exposing [String.length]
import Tesl.Json exposing [stringCodec]
import Tesl.ApiTest exposing [statusOk]

secret Password = String

fact LongEnough (text: String)

check isLongEnough(text: String) -> text: String ::: LongEnough text =
  if String.length text >= 8 then
    ok text ::: LongEnough text
  else
    fail 400 "Password too short"

record RegisterBody {
  email: String
  password: Password ::: LongEnough password
}
record RegisterOut { registered: Bool }

codec RegisterBody {
  toJson_forbidden
  fromJson [
    {
      email <- "email" with_codec stringCodec
      password <- "password" with_codec stringCodec via isLongEnough
    }
  ]
}

# The proof is consumed here only to prove it was established; the value that
# actually leaves this function protected is the `secret`, not the proof.
handler post register(body: RegisterBody) -> RegisterOut =
  let secretPassword = body.password
  let out = RegisterOut { registered: secretPassword == Password "unused-comparison" }
  out

api RegisterApi {
  post "/register"
    body body: RegisterBody
    -> RegisterOut
}

server RegisterServer for RegisterApi {
  register
}

api-test "a too-short password is rejected before it ever becomes a secret" for RegisterServer {
  let r = post "/register" body { "email": "a@example.com", "password": "short" }
  expect r.status == 400
}

api-test "a long-enough password validates, then is wrapped as a secret" for RegisterServer {
  let r = post "/register" body { "email": "a@example.com", "password": "hunter2222" }
  expect statusOk r.status
}
