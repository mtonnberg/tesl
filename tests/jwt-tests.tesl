# ─────────────────────────────────────────────────────────────────────────────
# jwt-tests.tesl
#
# Tesl-level tests for the Tesl.JWT stdlib module.
#
# Covers:
#   - JwtToken nominal newtype construction; Secret (Tesl.Crypto) as the key
#   - JWT.sign produces a JwtToken and stamps a fixed one-hour `exp` itself
#   - a caller-supplied `exp` is rejected (expiry is not the caller's to set)
#   - JWT.verify correct secret returns claims carrying an `Authentic` fact
#   - JWT.verify correct secret returns claims
#   - JWT.verify wrong secret returns error
#   - JWT.decode returns claims without signature check
#   - Capability enforcement with jwt
#   - Nominal type safety: JwtToken wraps String, Secret wraps String
#   - String value retrieval via .value field
# ─────────────────────────────────────────────────────────────────────────────

module JwtTests exposing [
  joseHeaderPrefix,
  joseHeaderLength,
  makeSecret,
  makeToken,
  wrapToken,
  signClaims,
  signClaimsWithOwnExp,
  subjectOfAuthenticClaims,
  verifyClaims,
  decodeClaims,
  checkTokenStr,
  tokenLength,
]

import Tesl.Prelude exposing [Bool(..), Int, String, List, Unit]
import Tesl.String exposing [
  String.length,
  String.startsWith,
  String.contains,
  String.slice,
]
import Tesl.Maybe exposing [Maybe(..)]
import Tesl.Dict exposing [Dict, Dict.singleton, Dict.fromList, Dict.lookup]
import Tesl.Tuple exposing [Tuple2]
# `time` is named only in the capability below: JWT.sign reads the clock to stamp
# the token's expiry.
import Tesl.Time exposing [time]
# The signing key is `Secret`, Tesl.Crypto's key-material type — Tesl.JWT has no
# key type of its own.  There was a separate JWT-only key type until 2026-07-30;
# it was deleted rather than aliased, because `Env.requireSecret` returns `Secret`
# and two key types forced every signing program to route the key through a
# String.
import Tesl.Crypto exposing [Secret, Crypto.keyFingerprint]
import Tesl.JWT exposing [
  jwt,
  JwtToken,
  JWT.sign,
  JWT.verify,
  JWT.decode,
  Authentic,
]

# ── Capability ────────────────────────────────────────────────────────────────

# `time` as well as `jwt`: JWT.sign stamps the expiry from the wall clock.
capability jwtCap implies jwt, time

# ── The JOSE header ───────────────────────────────────────────────────────────

# The base64url encoding of `{"alg":"HS256","typ":"JWT","kid":` — the part of the
# JOSE header that does NOT depend on the key.
#
# It used to be the whole header (`eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9` =
# `{"alg":"HS256","typ":"JWT"}`), which was a constant.  Since 2026-07-30
# `JWT.sign` stamps `kid` = `Crypto.keyFingerprint key`, so the header is a
# function OF THE KEY and only this prefix is stable.  The cut is at 33 bytes of
# JSON, a multiple of 3, so base64 group alignment makes it an exact 44-character
# prefix of every token — not an approximation.
joseHeaderPrefix = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6"

# The header segment is always exactly 70 characters: the 33-byte prefix plus
# `"<16 hex>"}`, and `Crypto.keyFingerprint` is always 16 hex characters.
joseHeaderLength = 70

# ── Helper functions ──────────────────────────────────────────────────────────

# Every test below goes through this helper rather than writing `Secret "…"`
# inline: a string LITERAL in a key position is what the SEC003 lint is for, and
# a test corpus that trips its own security lint trains the reader to ignore it.
fn makeSecret(s: String) -> Secret =
  Secret s

fn makeToken(s: String) -> JwtToken =
  JwtToken s

fn wrapToken(s: String) -> JwtToken =
  JwtToken s

# Claims are a Dict (the JWT payload is a JSON object); carry the test's string
# claim in a `sub` field and read it back out, so these helpers keep a String API.
fn signClaims(claims: String, secret: Secret) requires [jwtCap] -> JwtToken =
  JWT.sign (Dict.singleton "sub" claims) secret

# There is NO expiry parameter: JWT.sign stamps `exp` one hour ahead itself. A
# caller who supplies one is REJECTED rather than silently overridden, which is
# what this helper exercises — it typechecks (the claims are Dict String String,
# and "3600" is a String), and fails loudly at run time.
fn signClaimsWithOwnExp(claims: String, secret: Secret) requires [jwtCap] -> JwtToken =
  JWT.sign (Dict.fromList [Tuple2 "sub" claims, Tuple2 "exp" "3600"]) secret

# A consumer that DEMANDS the claims were verified. Only `check JWT.verify` can
# satisfy this; JWT.decode mints no fact, so it cannot be used to reach here.
fn subjectOfAuthenticClaims(claims: Dict String String ::: Authentic claims) -> String =
  case Dict.lookup "sub" claims of
    Nothing -> ""
    Something s -> s

# JWT.verify is check-shaped, so its result must be BOUND with `check` before it
# can be read — nesting it inside Dict.lookup would hand the lookup the raw
# check-fail on the failure path.
fn verifyClaims(token: JwtToken, secret: Secret) requires [jwtCap] -> String =
  let claims = check JWT.verify token secret
  case Dict.lookup "sub" claims of
    Nothing -> ""
    Something s -> s

fn decodeClaims(token: JwtToken) requires [jwtCap] -> String =
  case Dict.lookup "sub" (JWT.decode token) of
    Nothing -> ""
    Something s -> s

fn checkTokenStr(token: JwtToken) -> String =
  token.value

fn tokenLength(token: JwtToken) -> Int =
  String.length token.value

# ── Tests ─────────────────────────────────────────────────────────────────────

# NOTE on `Secret` and `.value`: Secret is a SECRET newtype, so it has no
# readable `.value` — reading the key back out as a String would defeat the
# redaction every rendering sink applies to it. T01/T10/T15/T20 below therefore
# assert what a secret is FOR (it signs, and signing is deterministic in it)
# rather than asserting the key round-trips.
test "T01: a Secret can be constructed and used to sign" requires [jwtCap] {
  let s = makeSecret "my-key"
  let token = signClaims "user" s
  expect String.startsWith token.value joseHeaderPrefix
}

test "T02: JwtToken constructor wraps a string" {
  let t = makeToken "header.payload.sig"
  expect t.value == "header.payload.sig"
}

test "T03: wrapToken produces JwtToken" {
  let t = wrapToken "abc.def.ghi"
  expect t.value == "abc.def.ghi"
}

test "T04: JWT.sign produces a token (trusts runtime)" requires [jwtCap] {
  let secret = makeSecret "test-secret"
  let token = signClaims "user123" secret
  expect String.length token.value > 0
}

test "T05: JWT token has three parts separated by dots" requires [jwtCap] {
  let secret = makeSecret "test-secret"
  let token = signClaims "user456" secret
  let tokenStr = token.value
  expect String.length tokenStr > 10
}

test "T06: JWT.sign token starts with known header" requires [jwtCap] {
  let secret = makeSecret "test-secret"
  let token = signClaims "alice" secret
  expect String.startsWith token.value joseHeaderPrefix
}

test "T07: JwtToken .value extracts the underlying string" {
  let t = makeToken "raw.token.string"
  expect t.value == "raw.token.string"
}

test "T08: tokenLength counts characters in token" requires [jwtCap] {
  let secret = makeSecret "key"
  let token = signClaims "user" secret
  expect tokenLength token > 20
}

test "T09: checkTokenStr returns the inner string" {
  let t = makeToken "x.y.z"
  expect checkTokenStr t == "x.y.z"
}

test "T10: makeSecret is deterministic — the same key string signs identically" requires [jwtCap] {
  let s1 = makeSecret "super-secret"
  let s2 = makeSecret "super-secret"
  expect (signClaims "user" s1).value == (signClaims "user" s2).value
}

test "T11: JWT.sign with long claims still produces token" requires [jwtCap] {
  let secret = makeSecret "s"
  let claims = "a-very-long-user-identifier-for-testing-purposes"
  let token = signClaims claims secret
  expect String.length token.value > 30
}

test "T12: different secrets produce different tokens" requires [jwtCap] {
  let s1 = makeSecret "key1"
  let s2 = makeSecret "key2"
  let t1 = signClaims "user" s1
  let t2 = signClaims "user" s2
  expect t1.value != t2.value
}

test "T13: same inputs always produce same token" requires [jwtCap] {
  let s = makeSecret "consistent-key"
  let t1 = signClaims "user" s
  let t2 = signClaims "user" s
  expect t1.value == t2.value
}

test "T14: JwtToken value is a non-empty string" {
  let t = makeToken "some.jwt.token"
  expect String.length t.value > 0
}

test "T15: the secret does not leak into the token it signs" requires [jwtCap] {
  let s = makeSecret "not-empty-secret"
  let token = signClaims "user" s
  expect !(String.contains token.value "not-empty-secret")
}

test "T16: signClaims token is not the same as the claims string" requires [jwtCap] {
  let secret = makeSecret "k"
  let claims = "user123"
  let token = signClaims claims secret
  expect token.value != claims
}

test "T17: signClaims with empty string secret produces token" requires [jwtCap] {
  let secret = makeSecret ""
  let token = signClaims "user" secret
  expect String.length token.value > 0
}

test "T18: decodeClaims extracts payload (no sig check)" requires [jwtCap] {
  let secret = makeSecret "test-key"
  let token = signClaims "decode-test" secret
  let _ = decodeClaims token
  expect True == True
}

test "T19: JwtToken wraps any string value" {
  let t1 = makeToken "a"
  let t2 = makeToken "bb"
  let t3 = makeToken "ccc"
  expect String.length t1.value < String.length t2.value
  expect String.length t2.value < String.length t3.value
}

test "T20: Secret and JwtToken are separate types" requires [jwtCap] {
  # A JwtToken's `.value` is readable; a Secret's is not (it is a secret
  # newtype) — that asymmetry IS the type distinction, and it is enforced at
  # compile time, so all this test can add is that both are constructible and
  # that the token side round-trips.
  let s = makeSecret "my-secret"
  let t = signClaims "my-user" s
  expect String.length t.value > 0
}

test "T21: a signed token verifies and keeps its other claims readable" requires [jwtCap] {
  let secret = makeSecret "expiry-key"
  let token = signClaims "user-with-expiry" secret
  expect verifyClaims token secret == "user-with-expiry"
  expect decodeClaims token == "user-with-expiry"
  expect String.startsWith token.value joseHeaderPrefix
}

# The `Authentic` fact (Crypto Phase 2). The interesting half of this is the
# NEGATIVE, which cannot be written here at all: swapping `check JWT.verify` for
# `JWT.decode` below does not compile, because decode mints no fact. That
# negative lives in compiler/test/test_jwt.ml, where a failed compile is the
# assertion.
test "T22: verified claims satisfy a consumer that demands Authentic" requires [jwtCap] {
  let secret = makeSecret "authentic-key"
  let token = signClaims "carol" secret
  let claims = check JWT.verify token secret
  expect subjectOfAuthenticClaims claims == "carol"
}

# ── The `kid` header stamp (2026-07-30) ───────────────────────────────────────
#
# `JWT.sign` stamps `kid` = `Crypto.keyFingerprint key` in the JOSE header, its
# RFC 7515 §4.1.4 home.  It is DERIVED, not chosen — there is no parameter — and
# it answers "which key signed this" from a log line without exposing the key.
#
# The verify side is untouched: it recomputes the HMAC over `header.payload`
# verbatim and never parses the header, so a token minted before this change and
# a foreign token with any header at all verify exactly as they did.  That
# backward compatibility is asserted in tests/jwt-test.rkt, which can forge a
# header-less token out of band; from Tesl there is no way to mint one.

test "T23: the header carries a kid, so it is no longer the same for every key" requires [jwtCap] {
  let s1 = makeSecret "kid-key-alpha"
  let s2 = makeSecret "kid-key-beta"
  let h1 = String.slice (signClaims "user" s1).value 0 joseHeaderLength
  let h2 = String.slice (signClaims "user" s2).value 0 joseHeaderLength
  expect String.startsWith h1 joseHeaderPrefix
  expect String.startsWith h2 joseHeaderPrefix
  expect h1 != h2
}

test "T24: the same key always stamps the same kid" requires [jwtCap] {
  let s = makeSecret "kid-stable-key"
  let h1 = String.slice (signClaims "alice" s).value 0 joseHeaderLength
  let h2 = String.slice (signClaims "bob" s).value 0 joseHeaderLength
  expect h1 == h2
}

test "T25: the kid is not the key — the key never appears in the token" requires [jwtCap] {
  # `Crypto.keyFingerprint` is a domain-separated digest truncated to 16 hex
  # characters, so it is safe to log; the key itself must not survive anywhere in
  # the token, header included.
  let s = makeSecret "kid-not-the-key"
  let token = signClaims "user" s
  expect !(String.contains token.value "kid-not-the-key")
  expect String.length (Crypto.keyFingerprint s) == 16
}
