module SecretFieldProof exposing [
  Password,
  RegisterBody,
  RegisterOut,
  register,
  RegisterApi,
  RegisterServer,
]

# roadmap/completed/secret_wrapped_credentials.md — the DIRECT composition:
# a record field typed AS the secret newtype itself, carrying the proof on the
# FIELD (record fields already support `::: Proof` — see
# tests/server-tools-tests.tesl's `TextSafe` field), decoded through the same
# `with_codec <prim> via <checkFn>` machinery every other validated field uses.
#
#   record RegisterBody { password: Password ::: LongEnough password }
#
# This used to be UNSOUND: the compiler wrapped the decoded value into the
# `secret` newtype BEFORE running `via isLongEnough`, so a check function
# declared `isLongEnough(text: String)` was actually invoked with the WRAPPED
# secret struct — it happened to still "work" because the stdlib's string
# helpers unwrap ANY newtype (secret or not) with no regard to secrecy, which
# meant the plaintext was fully reachable inside an arbitrary `via` function
# under a signature that claimed it never saw more than a `String` (a check
# function that put its argument in its own `fail` message would echo the
# plaintext straight into the client-facing 400). Fixed in emit_racket.ml: the
# raw base value decodes first, `via` runs on THAT (matching what
# `isLongEnough`'s own signature — and `check_codec_proof_coverage` — already
# promised), and the newtype constructor wraps only a successful check's
# value. compiler/test/test_secret_surface.ml pins the emitted order as a
# ratchet; this file is the end-to-end runtime proof.
#
# tests/secret-proof-composition-tests.tesl is the sibling that validates on a
# plain `String` field and constructs the `secret` explicitly in the handler
# — still correct, just one extra line. This is the same outcome with the
# field declaring both protections at once.

import Tesl.Prelude exposing [Bool, String]
import Tesl.String exposing [String.length]
import Tesl.Json exposing [stringCodec]
import Tesl.ApiTest exposing [statusOk]

secret Password = String

fact LongEnough (text: String)

check isLongEnough(text: String) -> text: String ::: LongEnough text =
  if String.length text >= 8 then
    ok text ::: LongEnough text
  else
    fail 400 "Password too short"

record RegisterBody {
  email: String
  password: Password ::: LongEnough password
}
record RegisterOut { registered: Bool }

codec RegisterBody {
  toJson_forbidden
  fromJson [
    {
      email <- "email" with_codec stringCodec
      password <- "password" with_codec stringCodec via isLongEnough
    }
  ]
}

# No manual wrap needed: `body.password` is already `Password`, redacted from
# the moment the codec accepted it.
handler register(body: RegisterBody) -> RegisterOut =
  let out = RegisterOut { registered: body.password == Password "unused-comparison" }
  out

api RegisterApi {
  post "/register"
    body body: RegisterBody
    -> RegisterOut
}

server RegisterServer for RegisterApi {
  register = register
}

api-test "a too-short password is rejected before it ever becomes a secret" for RegisterServer {
  let r = post "/register" body { "email": "a@example.com", "password": "short" }
  expect r.status == 400
}

api-test "a long-enough password validates directly into a redacted field" for RegisterServer {
  let r = post "/register" body { "email": "a@example.com", "password": "hunter2222" }
  expect statusOk r.status
}
