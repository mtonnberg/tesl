module ApiBoundaryRegressionTests exposing [
  RunsServer,
  OriginServer,
  CaptureServer,
  RunView,
  Evaluation,
  pickView,
  page,
  keysetAfter,
  Item,
]

# ─────────────────────────────────────────────────────────────────────────────
# Regressions at the API boundary: Maybe values from branching code, route
# precedence between a literal and a capture, headers on a `subscribe`, the
# Host an api-test sends to a `publicOrigin` server, newtype path captures and
# request-chosen `limit`/`offset` bounds.
#
# Every test asserts an OBSERVABLE answer (a status, a body, a delivered event),
# so a regression fails here rather than passing vacuously.
# ─────────────────────────────────────────────────────────────────────────────

import Tesl.Prelude exposing [Bool(..), Int, String, List]
import Tesl.Int exposing [Int.toString]
import Tesl.Http exposing [HttpRequest]
import Tesl.Dict exposing [Dict.lookup]
import Tesl.Maybe exposing [Maybe(..)]
import Tesl.Json exposing [stringCodec, intCodec]
import Tesl.Queue exposing [pubsub]
import Tesl.Database exposing [Database, Memory]
import Tesl.SSE exposing [SseChannel]
import Tesl.ApiTest exposing [statusOk, subscribe, collect, isNotEmpty]
import Tesl.List exposing [List.map, List.sortBy]
import Tesl.Tuple exposing [Tuple2(..)]
import Tesl.DB exposing [dbRead, dbWrite]

# ── a `Maybe` bound from a case/if whose FIRST branch is a bare `Nothing` ──
# The Go emitter took the Maybe's type argument from the first branch and emitted
# `Maybe[struct{}]`, which Go refused.  The branch order here is deliberately the
# conventional one the user had to avoid.

record Evaluation {
  score: Int
}

record RunView {
  evaluation: Maybe Evaluation
  cursor: Maybe String
  annotated: Maybe Int
}

fn pickView(score: Maybe Int, last: Bool) -> RunView =
  let evaluation = case score of
    Nothing -> Nothing
    Something n -> Something (Evaluation { score: n })
  let cursor = if last then
    Nothing
  else
    Something "next"
  let annotated: Maybe Int = case score of
    Nothing -> Nothing
    Something n -> Something (n + 1)
  RunView { evaluation: evaluation, cursor: cursor, annotated: annotated }

test "a Nothing-first case or if still settles the Maybe's type" {
  let some = pickView (Something 7) False
  expect some.evaluation == Something (Evaluation { score: 7 })
  expect some.cursor == Something "next"
  expect some.annotated == Something 8
  let none = pickView Nothing True
  expect none.evaluation == Nothing
  expect none.cursor == Nothing
  expect none.annotated == Nothing
}

# ── a literal `sse` route next to a `:capture` route, header auth ──

fact HasKey(who: String)

auth apiKeyAuth(req: HttpRequest) -> who: String ::: HasKey who =
  case Dict.lookup "x-api-key" req.headers of
    Nothing -> fail 401 "missing api key"
    Something key -> ok key ::: HasKey who

record RunEvent {
  runId: String
}

database RunsDb = Database {
  schema: "api_boundary_regressions"
  entities: []
  backend: Memory
}

sseChannel RunEvents(scope: String) = SseChannel {
  database: RunsDb
  payload: RunEvent
}

handler get getRun(identity: String ::: HasKey identity, runId: String) -> String =
  "run:" ++ runId

handler post publishRun(identity: String ::: HasKey identity, runId: String) -> String
  requires [pubsub] =
  publish RunEvents("all") RunEvent { runId: runId }
  "published"

api RunsApi {
  get "/runs/:runId"
    auth identity: String ::: HasKey identity via apiKeyAuth
    capture runId: String using stringCodec
    -> String

  sse "/runs/stream"
    auth identity: String ::: HasKey identity via apiKeyAuth
    subscribe RunEvents("all")

  post "/runs/:runId/publish"
    auth identity: String ::: HasKey identity via apiKeyAuth
    capture runId: String using stringCodec
    -> String
}

server RunsServer for RunsApi {
  getRun
  publishRun
}

api-test "header auth still guards the capture route" for RunsServer {
  let resp = get "/runs/abc"
  expect resp.status == 401
}

api-test "the capture route still answers every other id" for RunsServer {
  let resp = get "/runs/abc" headers { "x-api-key": "good-key" }
  expect statusOk resp.status
  expect resp.body == "run:abc"
}

api-test "the literal sse route wins and subscribe carries its headers" for RunsServer requires [pubsub] {
  let stream = subscribe "/runs/stream" headers { "x-api-key": "good-key" }
  let resp = post "/runs/r-1/publish" headers { "x-api-key": "good-key" }
  expect statusOk resp.status
  let events = collect stream count 1 timeout 1500ms
  expect isNotEmpty events
}

# A plain request to an `sse` route answers whether the subscription would be accepted:
# a refused one is an ordinary 401 a test can assert (`subscribe` itself traps on refusal),
# and an accepted one returns its status and headers instead of waiting on the open stream.
api-test "a refused subscription is an ordinary 401 to a plain get" for RunsServer {
  let resp = get "/runs/stream"
  expect resp.status == 401
}

api-test "an accepted subscription answers a plain get without waiting on the stream" for RunsServer {
  let resp = get "/runs/stream" headers { "x-api-key": "good-key" }
  expect resp.status == 200
  expect Dict.lookup "content-type" resp.headers == Something "text/event-stream"
}

# ── a `publicOrigin` server's api-tests need no hand-written Host ────────

handler get ping() -> String =
  "pong"

api OriginApi {
  get "/ping"
    -> String
}

server OriginServer for OriginApi {
  ping
  publicOrigin "https://runs.example.com"
}

api-test "a request with no Host is addressed to the app's own origin" for OriginServer {
  let resp = get "/ping"
  expect statusOk resp.status
  expect resp.body == "pong"
}

api-test "an explicit foreign Host is still refused" for OriginServer {
  let resp = get "/ping" headers { "Host": "attacker.example.net" }
  expect resp.status == 421
}

# ── A capture typed as a newtype over the codec's type ───────────────────────
# `check` accepted `capture uid: UserId using stringCodec` (and its Int twin);
# the emitter refused it, which `check` now reports — so the emitter supports it.

type UserId = String

type Iteration = Int

handler get userIteration(uid: UserId, n: Iteration) -> String =
  uid.value ++ "#" ++ Int.toString n.value

api CaptureApi {
  get "/users/:uid/iterations/:n"
    capture uid: UserId using stringCodec
    capture n: Iteration using intCodec
    -> String
}

server CaptureServer for CaptureApi {
  userIteration
}

api-test "a newtype capture is parsed at its base type and wrapped" for CaptureServer {
  let resp = get "/users/ada/iterations/3"
  expect statusOk resp.status
  expect resp.body == "ada#3"
  let bad = get "/users/ada/iterations/three"
  expect bad.status == 400
}

# ── a `limit`/`offset` the request chooses ──────────────────────────────
# Only an integer LITERAL lowered; a page size from a query parameter had to be
# fetched as a fixed window and sliced in Tesl.  Now it is bound as a statement
# parameter (PostgreSQL) and a count (memory store); a negative bound reads
# nothing.

entity Item table "api_boundary_items" primaryKey id {
  id: String
  rank: Int
}

database ItemsDb = Database {
  schema: "api_boundary_items"
  entities: [Item]
  backend: Memory
}

fn page(size: Int, skip: Int) -> List String
  requires [dbRead Item] =
  List.map (fn (i: Item) -> i.id) (select i from Item order i.rank asc limit size offset skip)

test "limit and offset may be Int expressions" requires [dbRead Item, dbWrite Item] {
  insert Item { id: "a", rank: 1 }
  insert Item { id: "b", rank: 2 }
  insert Item { id: "c", rank: 3 }
  insert Item { id: "d", rank: 4 }
  expect page 2 0 == ["a", "b"]
  expect page 2 1 == ["b", "c"]
  expect page 10 3 == ["d"]
  expect page 0 0 == []
  expect page (0 - 5) 0 == []
}

# ── Keyset paging: `a < x || (a == x && b < y)` and a tuple sort key ──────────
# The OR of an AND did not lower, and `List.sortBy` with a Tuple2 key was refused
# by the backend; together they are how a cursor-paged list orders rows by one
# column with a tie-break on another.

fn keysetAfter(rank: Int, id: String) -> List String
  requires [dbRead Item] =
  let rows = select i from Item where i.rank < rank || (i.rank == rank && i.id < id)
  List.map (fn (i: Item) -> i.id) (List.sortBy (fn (i: Item) -> Tuple2 i.rank i.id) rows)

test "an OR of an AND filters, and a tuple key sorts lexicographically" requires [dbRead Item, dbWrite Item] {
  insert Item { id: "c", rank: 2 }
  insert Item { id: "a", rank: 1 }
  insert Item { id: "b", rank: 2 }
  insert Item { id: "z", rank: 0 }
  insert Item { id: "d", rank: 3 }
  expect keysetAfter 2 "c" == ["z", "a", "b"]
  expect keysetAfter 9 "a" == ["z", "a", "b", "c", "d"]
}
