func teslCheckAll1(teslValue teslrt.Int) teslrt.Check[teslrt.Int] {
	teslStep0 := checkPos(teslValue)
	if !teslStep0.OK() {
		return teslrt.Reject[teslrt.Int](teslStep0.Status(), teslStep0.Message())
	}
	teslStep1 := checkSmall(teslrt.MustCheck(teslStep0))
	return teslStep1
}

func teslCheckAll2(teslValue teslrt.Int) teslrt.Check[teslrt.Int] {
	teslStep0 := checkActive(teslValue)
	if !teslStep0.OK() {
		return teslrt.Reject[teslrt.Int](teslStep0.Status(), teslStep0.Message())
	}
	teslStep1 := checkPinned(teslrt.MustCheck(teslStep0))
	return teslStep1
}

func teslKeyLessString(teslX, teslY string) bool {
	return (teslX < teslY)
}

func teslLessTeslrtInt(teslX, teslY teslrt.Int) bool {
	return (teslrt.Compare(teslX, teslY) < 0)
}

