		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	defer func() {
		if teslTrap := recover(); teslTrap != nil {
			teslT.Fatalf("Tesl test trapped: %v", teslTrap)
		}
	}()
	{
//line adversarial-review-tests.tesl:1641
		result := FilteredPositives([]teslrt.Int{teslrt.FromInt64(10), teslrt.FromInt64(20), teslrt.FromInt64(30)})
		_ = result
		teslLeft179 := teslrt.ListLength(result)
//line adversarial-review-tests.tesl:1642
		if !teslrt.Equal(teslLeft179, teslrt.FromInt64(3)) {
//line adversarial-review-tests.tesl:1642
			teslT.Fatal("Tesl expectation failed")
		}
	}
}

func TestTesl137(teslT *testing.T) {
	if teslWanted := os.Getenv("TESL_TEST_NAME"); teslWanted != "" && teslWanted != "Bug7: filterCheck all negative gives empty list" && teslWanted != "TestTesl137" {
		teslT.Skip("named test filter")
	}
	if teslKind := os.Getenv("TESL_TEST_KIND"); teslKind != "" && teslKind != "test" {
		teslT.Skip("test kind filter")
	}
	defer func() {
		if teslTrap := recover(); teslTrap != nil {
			teslT.Fatalf("Tesl test trapped: %v", teslTrap)
		}
	}()
	{
//line adversarial-review-tests.tesl:1646
		result := FilteredPositives([]teslrt.Int{teslrt.Neg(teslrt.FromInt64(1)), teslrt.Neg(teslrt.FromInt64(2)), teslrt.Neg(teslrt.FromInt64(3))})
		_ = result
		teslLeft180 := teslrt.ListLength(result)
//line adversarial-review-tests.tesl:1647
		if !teslrt.Equal(teslLeft180, teslrt.FromInt64(0)) {
//line adversarial-review-tests.tesl:1647
			teslT.Fatal("Tesl expectation failed")
		}
	}
}
