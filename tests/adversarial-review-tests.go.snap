//line adversarial-review-tests.tesl:1228
func TreeDepth(t Tree) teslrt.Int {
//line adversarial-review-tests.tesl:1229
	{
		teslScrut1 := t
		switch teslScrut1.Tag {
		case TreeLeaf:
//line adversarial-review-tests.tesl:1230
			return teslrt.FromInt64(0)
		case TreeNode:
			left := teslrt.Unboxed(teslScrut1.NodeLeft)
			_ = left
			right := teslrt.Unboxed(teslScrut1.NodeRight)
			_ = right
			{
//line adversarial-review-tests.tesl:1232
				leftDepth := TreeDepth(left)
				_ = leftDepth
				{
//line adversarial-review-tests.tesl:1233
					rightDepth := TreeDepth(right)
					_ = rightDepth
//line adversarial-review-tests.tesl:1234
					if teslrt.Compare(leftDepth, rightDepth) > 0 {
//line adversarial-review-tests.tesl:1235
						return teslrt.Add(teslrt.FromInt64(1), leftDepth)
					} else {
//line adversarial-review-tests.tesl:1237
						return teslrt.Add(teslrt.FromInt64(1), rightDepth)
					}
				}
			}
		default:
			panic("unreachable: checker guarantees case exhaustiveness")
		}
	}
}

//line adversarial-review-tests.tesl:1268
func Factorial(n teslrt.Int) teslrt.Int {
//line adversarial-review-tests.tesl:1269
	if teslrt.Compare(n, teslrt.FromInt64(0)) <= 0 {
//line adversarial-review-tests.tesl:1270
		return teslrt.FromInt64(1)
	} else {
//line adversarial-review-tests.tesl:1272
		return teslrt.Mul(n, Factorial(teslrt.Sub(n, teslrt.FromInt64(1))))
	}
}

//line adversarial-review-tests.tesl:1274
func Fibonacci(n teslrt.Int) teslrt.Int {
//line adversarial-review-tests.tesl:1275
	if teslrt.Compare(n, teslrt.FromInt64(0)) <= 0 {
//line adversarial-review-tests.tesl:1276
		return teslrt.FromInt64(0)
	} else {
//line adversarial-review-tests.tesl:1278
		if teslrt.Equal(n, teslrt.FromInt64(1)) {
//line adversarial-review-tests.tesl:1279
			return teslrt.FromInt64(1)
		} else {
//line adversarial-review-tests.tesl:1281
			return teslrt.Add(Fibonacci(teslrt.Sub(n, teslrt.FromInt64(1))), Fibonacci(teslrt.Sub(n, teslrt.FromInt64(2))))
		}
	}
}

