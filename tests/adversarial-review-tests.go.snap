func classifyThreshold(t Threshold) string {
//line adversarial-review-tests.tesl:862
	{
		teslScrut1 := t
		if teslScrut1.Tag == ThresholdLow {
			n := teslScrut1.LowN
			_ = n
			if teslrt.Compare(n, teslrt.FromInt64(0)) < 0 {
//line adversarial-review-tests.tesl:863
				return "low-negative"
			}
		}
		if teslScrut1.Tag == ThresholdLow {
			n := teslScrut1.LowN
			_ = n
//line adversarial-review-tests.tesl:864
			return "low-nonneg"
		}
		if teslScrut1.Tag == ThresholdMid {
			n := teslScrut1.MidN
			_ = n
			if teslrt.Compare(n, teslrt.FromInt64(50)) > 0 {
//line adversarial-review-tests.tesl:865
				return "mid-high"
			}
		}
		if teslScrut1.Tag == ThresholdMid {
//line adversarial-review-tests.tesl:866
			return "mid-low"
		}
		if teslScrut1.Tag == ThresholdHigh {
//line adversarial-review-tests.tesl:867
			return "high"
		}
		panic("unreachable: checker guarantees case exhaustiveness")
	}
}

