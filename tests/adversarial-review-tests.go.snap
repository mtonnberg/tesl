				v := teslrt.MustCheck(checkAtLeastFive(n))
				_ = v
				return (teslrt.Compare(v, teslrt.FromInt64(5)) >= 0)
			}()) {
				teslT.Fatalf("property \"checkAtLeastFive succeeds for >= 5\" failed (n=%v)", n)
			}
		}
	}
}

