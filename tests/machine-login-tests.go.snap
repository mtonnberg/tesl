	return teslrt.Reject[NewWidget](400, "no decode alternative matched")
}

func EncodeCreatedJSON(teslValue Created) any {
	return map[string]any{
		"id":    teslValue.Id,
		"orgId": teslValue.OrgId,
	}
}

func teslDecodeLoginRequestAlt0(teslJSON any) teslrt.Check[LoginRequest] {
	teslFieldUser, teslErrUser := teslrt.DecodeStringField(teslJSON, "user")
	if teslErrUser != nil {
		return teslrt.RejectShape[LoginRequest](teslErrUser.Error())
	}
	teslDecoded := LoginRequest{User: teslFieldUser}
	return teslrt.Accept(teslDecoded)
}

func DecodeLoginRequestJSON(teslJSON any) teslrt.Check[LoginRequest] {
	var teslFirstFailure teslrt.Check[LoginRequest]
	teslHaveFailure := false
	teslResult0 := teslDecodeLoginRequestAlt0(teslJSON)
	if teslResult0.OK() {
		return teslResult0
	}
	if !teslResult0.IsShapeMismatch() && !teslHaveFailure {
		teslFirstFailure = teslResult0
		teslHaveFailure = true
	}
	if teslHaveFailure {
		return teslFirstFailure
	}
	return teslrt.Reject[LoginRequest](400, "no decode alternative matched")
}

func EncodeLoginOkJSON(teslValue LoginOk) any {
	return map[string]any{
		"success": teslValue.Success,
	}
}

func EncodeHumanWhoJSON(teslValue HumanWho) any {
	return map[string]any{
		"user": teslValue.User,
	}
}

var MachineServer = teslrt.Server{
	Routes: []teslrt.Route{
		{Method: "GET", Path: "/machine/whoami", Endpoint: "machineWhoami"},
		{Method: "GET", Path: "/hmac/whoami", Endpoint: "hmacWhoami"},
		{Method: "GET", Path: "/machine/widgets", Endpoint: "listWidgets"},
		{Method: "POST", Path: "/machine/widgets", Endpoint: "createWidget"},
		{Method: "POST", Path: "/login", Endpoint: "login"},
		{Method: "GET", Path: "/session/whoami", Endpoint: "humanWhoami"},
	},
	Handlers: map[string]teslrt.HandlerFunc{
		"machineWhoami": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
			teslBodyBytes, teslBodyStatus, teslBodyMessage := teslrt.ReadRequestBody(teslRequest)
			if teslBodyStatus != 0 {
				return teslrt.Fail(teslBodyStatus, teslBodyMessage)
			}
			teslBodyText := string(teslBodyBytes)
			teslAuth := machineAuth(teslrt.NewHttpRequest(teslRequest, teslBodyText, []string{}...))
			if !teslAuth.OK() {
				return teslrt.Fail(teslAuth.Status(), teslAuth.Message())
			}
			c, _ := teslAuth.Value()
			return teslrt.Response{Status: 200, Body: EncodeWhoJSON(machineWhoami(c))}
		},
		"hmacWhoami": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
			teslBodyBytes, teslBodyStatus, teslBodyMessage := teslrt.ReadRequestBody(teslRequest)
			if teslBodyStatus != 0 {
				return teslrt.Fail(teslBodyStatus, teslBodyMessage)
			}
			teslBodyText := string(teslBodyBytes)
			teslAuth := hmacMachineAuth(teslrt.NewHttpRequest(teslRequest, teslBodyText, []string{}...))
			if !teslAuth.OK() {
				return teslrt.Fail(teslAuth.Status(), teslAuth.Message())
			}
			c, _ := teslAuth.Value()
			return teslrt.Response{Status: 200, Body: EncodeHmacWhoJSON(hmacWhoami(c))}
		},
		"listWidgets": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
			teslBodyBytes, teslBodyStatus, teslBodyMessage := teslrt.ReadRequestBody(teslRequest)
			if teslBodyStatus != 0 {
				return teslrt.Fail(teslBodyStatus, teslBodyMessage)
			}
			teslBodyText := string(teslBodyBytes)
			teslAuth := machineAuth(teslrt.NewHttpRequest(teslRequest, teslBodyText, []string{}...))
			if !teslAuth.OK() {
				return teslrt.Fail(teslAuth.Status(), teslAuth.Message())
			}
			c, _ := teslAuth.Value()
			return teslrt.Response{Status: 200, Body: EncodeWidgetListJSON(listWidgets(c))}
		},
		"createWidget": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
			teslBodyBytes, teslBodyStatus, teslBodyMessage := teslrt.ReadRequestBody(teslRequest)
			if teslBodyStatus != 0 {
				return teslrt.Fail(teslBodyStatus, teslBodyMessage)
			}
			teslBodyText := string(teslBodyBytes)
			teslAuth := machineAuth(teslrt.NewHttpRequest(teslRequest, teslBodyText, []string{}...))
			if !teslAuth.OK() {
				return teslrt.Fail(teslAuth.Status(), teslAuth.Message())
			}
			c, _ := teslAuth.Value()
			if teslStatus, teslMessage := teslrt.CheckJSONPayload(teslRequest, teslBodyBytes); teslStatus != 0 {
				return teslrt.Fail(teslStatus, teslMessage)
			}
			teslParsed, teslParseErr := teslrt.ParseJSON(teslBodyBytes)
			if teslParseErr != nil {
				return teslrt.Fail(400, "Malformed JSON payload")
			}
			teslDecoded := DecodeNewWidgetJSON(teslParsed)
			if !teslDecoded.OK() {
				return teslrt.Fail(teslDecoded.Status(), teslDecoded.Message())
			}
			teslBody, _ := teslDecoded.Value()
			return teslrt.Response{Status: 200, Body: EncodeCreatedJSON(createWidget(c, teslBody))}
		},
		"login": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
			teslBodyBytes, teslBodyStatus, teslBodyMessage := teslrt.ReadRequestBody(teslRequest)
			if teslBodyStatus != 0 {
				return teslrt.Fail(teslBodyStatus, teslBodyMessage)
			}
			if teslStatus, teslMessage := teslrt.CheckJSONPayload(teslRequest, teslBodyBytes); teslStatus != 0 {
				return teslrt.Fail(teslStatus, teslMessage)
			}
			teslParsed, teslParseErr := teslrt.ParseJSON(teslBodyBytes)
			if teslParseErr != nil {
				return teslrt.Fail(400, "Malformed JSON payload")
			}
			teslDecoded := DecodeLoginRequestJSON(teslParsed)
			if !teslDecoded.OK() {
				return teslrt.Fail(teslDecoded.Status(), teslDecoded.Message())
			}
			teslBody, _ := teslDecoded.Value()
			return teslrt.Response{Status: 200, Body: EncodeLoginOkJSON(login(teslScope, teslBody))}
		},
		"humanWhoami": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
			teslBodyBytes, teslBodyStatus, teslBodyMessage := teslrt.ReadRequestBody(teslRequest)
			if teslBodyStatus != 0 {
				return teslrt.Fail(teslBodyStatus, teslBodyMessage)
			}
			teslBodyText := string(teslBodyBytes)
			teslAuth := sessionOwner(teslScope, teslrt.NewHttpRequest(teslRequest, teslBodyText, []string{}...))
			if !teslAuth.OK() {
				return teslrt.Fail(teslAuth.Status(), teslAuth.Message())
			}
			user, _ := teslAuth.Value()
			return teslrt.Response{Status: 200, Body: EncodeHumanWhoJSON(humanWhoami(user))}
		},
	},
}

func teslEqualScope(teslX, teslY Scope) bool {
	return teslX.TeslEqual(teslY)
}

func teslKeyLessString(teslX, teslY string) bool {
	return (teslX < teslY)
}

