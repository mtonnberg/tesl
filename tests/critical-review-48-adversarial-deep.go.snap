var Fix4RoutingCaptureServer = teslrt.Server{
	Routes: []teslrt.Route{
		{Method: "GET", Path: "/items/:itemId", Endpoint: "getItem"},
		{Method: "GET", Path: "/users/:uid", Endpoint: "getUser"},
	},
	Handlers: map[string]teslrt.HandlerFunc{
		"getItem": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
			teslBodyBytes, teslBodyStatus, teslBodyMessage := teslrt.ReadRequestBody(teslRequest)
			if teslBodyStatus != 0 {
				return teslrt.Fail(teslBodyStatus, teslBodyMessage)
			}
			teslBodyText := string(teslBodyBytes)
			teslAuth := itemCookieAuth(teslrt.NewHttpRequest(teslRequest, teslBodyText, []string{}...))
			if !teslAuth.OK() {
				return teslrt.Fail(teslAuth.Status(), teslAuth.Message())
			}
			user, _ := teslAuth.Value()
			itemId, teslFoundItemId := teslrt.PathParam("/items/:itemId", teslRequest.URL.Path, "itemId")
			if !teslFoundItemId {
				return teslrt.Fail(404, "not found")
			}
			return teslrt.Response{Status: 200, Body: EncodeItemResponseJSON(getItem(user, itemId))}
		},
		"getUser": func(teslScope *teslrt.RequestScope, teslRequest *http.Request) teslrt.Response {
			_ = teslScope
			teslBodyBytes, teslBodyStatus, teslBodyMessage := teslrt.ReadRequestBody(teslRequest)
			if teslBodyStatus != 0 {
				return teslrt.Fail(teslBodyStatus, teslBodyMessage)
			}
			teslBodyText := string(teslBodyBytes)
			teslAuth := userCookieAuth(teslrt.NewHttpRequest(teslRequest, teslBodyText, []string{}...))
			if !teslAuth.OK() {
				return teslrt.Fail(teslAuth.Status(), teslAuth.Message())
			}
			user, _ := teslAuth.Value()
			uid, teslFoundUid := teslrt.PathParam("/users/:uid", teslRequest.URL.Path, "uid")
			if !teslFoundUid {
				return teslrt.Fail(404, "not found")
			}
			return teslrt.Response{Status: 200, Body: EncodeUserResponseJSON(getUser(user, uid))}
		},
	},
}

func teslCheckAll1(teslValue teslrt.Int) teslrt.Check[teslrt.Int] {
	teslStep0 := checkValidated(teslValue)
	if !teslStep0.OK() {
		return teslrt.Reject[teslrt.Int](teslStep0.Status(), teslStep0.Message())
	}
	teslStep1 := checkInBounds(teslrt.MustCheck(teslStep0))
	return teslStep1
}

func teslKeyLessString(teslX, teslY string) bool {
	return (teslX < teslY)
}

