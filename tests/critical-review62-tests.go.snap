func teslCheckAll1(teslValue teslrt.Int) teslrt.Check[teslrt.Int] {
	teslStep0 := checkPos(teslValue)
	if !teslStep0.OK() {
		return teslrt.Reject[teslrt.Int](teslStep0.Status(), teslStep0.Message())
	}
	teslStep1 := checkSmall(teslrt.MustCheck(teslStep0))
	return teslStep1
}

