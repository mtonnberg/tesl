			teslT.Fatal("expected Tesl failure")
		}
	}()
	teslThunk()
}

func teslCheckAll1(teslValue string) teslrt.Check[string] {
	teslStep0 := checkA35(teslValue)
	if !teslStep0.OK() {
		return teslrt.Reject[string](teslStep0.Status(), teslStep0.Message())
	}
	teslStep1 := CheckB35(teslrt.MustCheck(teslStep0))
	return teslStep1
}

func teslCheckAll2(teslValue string) teslrt.Check[string] {
	teslStep0 := CheckB35(teslValue)
	if !teslStep0.OK() {
		return teslrt.Reject[string](teslStep0.Status(), teslStep0.Message())
	}
	teslStep1 := checkA35(teslrt.MustCheck(teslStep0))
	return teslStep1
}

func teslEqualString(teslX, teslY string) bool {
	return (teslX == teslY)
}

func teslEqualStruct(teslX, teslY struct{}) bool {
	return (teslX == teslY)
}

func teslEqualTeslrtInt(teslX, teslY teslrt.Int) bool {
	return teslrt.Equal(teslX, teslY)
}

func teslKeyLessString(teslX, teslY string) bool {
	return (teslX < teslY)
}

func teslKeyLessTeslrtInt(teslX, teslY teslrt.Int) bool {
	return (teslrt.Compare(teslX, teslY) < 0)
}

func teslKeyTeslrtInt(teslX teslrt.Int) teslrt.IntKey {
	return teslX.Key()
}

func teslLessTeslrtInt(teslX, teslY teslrt.Int) bool {
	return (teslrt.Compare(teslX, teslY) < 0)
}

