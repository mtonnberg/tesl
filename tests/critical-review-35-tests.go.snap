			teslT.Fatalf("Tesl test trapped: %v", teslTrap)
		}
	}()
	for teslPropRun1 := 0; teslPropRun1 < 50; teslPropRun1++ {
//line critical-review-35-tests.tesl:846
		xs := teslrt.PropList(func() teslrt.Int { return teslrt.PropInt() })
		_ = xs
		if !teslrt.ListEqualBy(teslrt.ListReverse(teslrt.ListReverse(xs)), xs, teslEqualTeslrtInt) {
			teslT.Fatalf("property \"reverse involution\" failed (xs=%v)", xs)
		}
	}
	for teslPropRun1 := 0; teslPropRun1 < 50; teslPropRun1++ {
//line critical-review-35-tests.tesl:849
		xs := teslrt.PropList(func() teslrt.Int { return teslrt.PropInt() })
		_ = xs
		if !teslrt.ListEqualBy(teslrt.ListSortBy(teslrt.ListSortBy(xs, teslLessTeslrtInt), teslLessTeslrtInt), teslrt.ListSortBy(xs, teslLessTeslrtInt), teslEqualTeslrtInt) {
			teslT.Fatalf("property \"sort idempotent\" failed (xs=%v)", xs)
		}
	}
	for teslPropRun1 := 0; teslPropRun1 < 50; teslPropRun1++ {
//line critical-review-35-tests.tesl:852
		xs := teslrt.PropList(func() teslrt.Int { return teslrt.PropInt() })
		_ = xs
		if teslrt.Compare(teslrt.ListLength(xs), teslrt.FromInt64(0)) < 0 {
			teslT.Fatalf("property \"length non-negative\" failed (xs=%v)", xs)
		}
	}
	for teslPropRun1 := 0; teslPropRun1 < 50; teslPropRun1++ {
//line critical-review-35-tests.tesl:855
		xs := teslrt.PropList(func() teslrt.Int { return teslrt.PropInt() })
		_ = xs
		ys := teslrt.PropList(func() teslrt.Int { return teslrt.PropInt() })
		_ = ys
		if !teslrt.Equal(teslrt.ListLength(teslrt.ListAppend(xs, ys)), teslrt.Add(teslrt.ListLength(xs), teslrt.ListLength(ys))) {
			teslT.Fatalf("property \"append length additive\" failed (xs=%v, ys=%v)", xs, ys)
		}
	}
}

