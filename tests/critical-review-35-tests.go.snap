			if !teslrt.Equal(teslrt.Mul(a, b), teslrt.Mul(b, a)) {
				teslT.Fatalf("property \"multiplication commutative\" failed (a=%v, b=%v)", a, b)
			}
		}
	}
	for teslPropRun1 := 0; teslPropRun1 < 50; teslPropRun1++ {
//line critical-review-35-tests.tesl:836
