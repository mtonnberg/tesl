module StorageSchema.VCurrent exposing [Sample]

import Tesl.Prelude exposing [String]
import Tesl.Int32 exposing [Int32]
import StorageSchema.VCurrent.Text

entity Sample table "samples" primaryKey id {
  id: String
  label: StorageSchema.VCurrent.Text.Int32
  builtin: Int32
  bounded: Int32 @db(integer)
  wide: Int32 @db(bigint)
}
