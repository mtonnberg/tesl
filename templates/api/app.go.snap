func teslColumnStatus(teslText []byte) Status {
	teslParsed, teslParseErr := teslrt.ParseColumnJSON(teslText)
	if teslParseErr != nil {
		panic("database: a Status column holds text that is not JSON: " + teslParseErr.Error())
	}
	teslTag, teslTagErr := teslrt.DecodeStringField(teslParsed, "tag")
	if teslTagErr != nil {
		panic("database: a Status column holds " + teslTagErr.Error())
	}
	switch teslTag {
	case "Open":
		return Status{Tag: StatusOpen}
	case "Done":
		return Status{Tag: StatusDone}
	}
	panic("database: a Status column holds an unknown tag " + teslTag)
}

func teslEncode1(teslValue Status) any {
	return func() any {
		switch teslValue.Tag {
		case StatusOpen:
			return map[string]any{"tag": "Open"}
		case StatusDone:
			return map[string]any{"tag": "Done"}
		}
		panic("unreachable: checker guarantees case exhaustiveness")
	}()
}

func teslEncode2(teslValue string) any {
	return teslValue
}

func teslEncode3(teslValue UserId) any {
	return teslEncode2(teslValue.Value)
}

func teslEncode4(teslValue teslrt.Int) any {
	return teslValue
}

func teslEncode5(teslValue teslrt.PosixMillis) any {
	return teslEncode4(teslValue.Value)
}

func teslEncode6(teslValue Todo) any {
	return map[string]any{
		"id":        teslEncode2(teslValue.Id),
		"title":     teslEncode2(teslValue.Title),
		"ownerId":   teslEncode3(teslValue.OwnerId),
		"status":    teslEncode1(teslValue.Status),
		"createdAt": teslEncode5(teslValue.CreatedAt),
	}
}

func teslKeyLessString(teslX, teslY string) bool {
	return (teslX < teslY)
}

func teslScanTodo(teslRow pgx.CollectableRow) (Todo, error) {
	teslValue := Todo{}
	var teslColumn0 string
	var teslColumn1 string
	var teslColumn2 string
	var teslColumn3 []byte
	var teslColumn4 int64
	if teslErr := teslRow.Scan(&teslColumn0, &teslColumn1, &teslColumn2, &teslColumn3, &teslColumn4); teslErr != nil {
		return teslValue, teslErr
	}
	teslValue.Id = teslColumn0
	teslValue.Title = teslColumn1
	teslValue.OwnerId = UserId{Value: teslColumn2}
	teslValue.Status = teslColumnStatus(teslColumn3)
	teslValue.CreatedAt = teslrt.PosixMillis{Value: teslrt.FromInt64(teslColumn4)}
	return teslValue, nil
}

