		teslT.Skip("test kind filter")
	}
	teslResetTestState()
	defer func() {
		if teslTrap := recover(); teslTrap != nil {
			teslT.Fatalf("Tesl test trapped: %v", teslTrap)
		}
	}()
//line app.tesl:217
	if teslrt.Compare(teslrt.StringLength("Read the Tesl tutorial"), teslrt.FromInt64(4)) < 0 {
//line app.tesl:217
		teslT.Fatal("Tesl expectation failed")
	}
//line app.tesl:218
	if teslrt.Compare(teslrt.StringLength("abc"), teslrt.FromInt64(4)) >= 0 {
//line app.tesl:218
		teslT.Fatal("Tesl expectation failed")
