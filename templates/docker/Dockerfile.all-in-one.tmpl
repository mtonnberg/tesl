# syntax=docker/dockerfile:1
# Legacy template name: PostgreSQL remains external and is not installed here.
FROM debian:bookworm-slim
LABEL org.opencontainers.image.title="__APP_NAME__" \
      org.opencontainers.image.description="Tesl Go app (external PostgreSQL)"
WORKDIR /opt/tesl/app
COPY tesl-app /usr/local/bin/tesl-app
ENV PORT=__PORT__
EXPOSE __PORT__
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/tesl-app"]
